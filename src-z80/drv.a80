	device NOSLOT64K
; ---------------------------------------------------------------------------
zYM2612_A0	equ $4000
zYM2612_D0	equ $4001
zYM2612_A1	equ $4002
zYM2612_D1	equ $4003
zBankRegister	equ $6000
zPSG		equ $7F11
zROMWindow	equ $8000

rstalign macro
	assert $<=38h
	align 8
	endm
valfor68k macro label,value
label	equ value
	export label
	endm
; ---------------------------------------------------------------------------
		org $0FC0
playback_resting	equ 1	; 1 (02h): seems to be "track is at rest"
playback_override	equ 2	; 2 (04h): SFX is overriding this track
playback_noattack	equ 4	; 4 (10h): do not attack next note
playback_playing	equ 7	; 7 (80h): track is playing

	STRUCT zTrack
; expected to be 0
PlaybackControl:	defb	
	; 	"voice control"; bits:
	; 	2 (04h): If set, bound for part II, otherwise 0 (see zWriteFMIorII)
	; 		-- bit 2 has to do with sending key on/off, which uses this differentiation bit directly
	; 	7 (80h): PSG Track
; expected to be 1
VoiceControl:		defb
TempoDivider:		defb	; timing divisor; 1 = Normal, 2 = Half, 3 = Third...

; these are expected to be in this order for various LDIR instructions
DataPointerLow:		defb	; Track's position low byte
DataPointerHigh:	defb	; Track's position high byte
;DataBank:		defb	; Tracks position rom bank
Transpose:		defb	; Transpose (from coord flag E9)
Volume:			defb	; channel volume
ModulationCtrl:		defb	; 0 means no modulation, bit 7 set means use modalgo
VolEnvID:		defb	; 

VolEnvIndex:		defb	; 
AMSFMSPan:		defb	; Panning / AMS / FMS settings
StackPointer:		defb	; "Gosub" stack position offset (starts at 2Ah, i.e. end of track, and each jump decrements by 2)
DurationTimeout:	defb	; current duration timeout; counting down to zero
SavedDuration:		defb	; last set duration (if a note follows a note, this is reapplied to 0Bh)

FreqLow:		defb	; FM/PSG: frequency low byte
FreqHigh:		defb	; FM/PSG: frequency high byte
NoteFillTimeout:	defb	; Currently set note fill; counts down to zero and then cuts off note
NoteFillMaster:		defb	; Reset value for current note fill
ModulationPtrLow:	defb	; low byte of address of current modulation setting
ModulationPtrHigh:	defb	; high byte of address of current modulation setting
ModulationWait:		defb	; Wait for ww period of time before modulation starts
ModulationSpeed:	defb	; Modulation Speed
ModulationDelta:	defb	; Modulation change per Mod. Step
ModulationSteps:	defb	; Number of steps in modulation (divided by 2)
ModulationValLow:	defb	; Current modulation value low byte
ModulationValHigh:	defb	; Current modulation value high byte
Detune:			defb	; Set by detune coord flag E1; used to add directly to FM/PSG frequency

SavedDAC:		;defb	; DAC: Next drum to play
PSGNoise:		;defb	; PSG: noise setting
VoiceID:		defb	; Current voice in use OR current PSG tone
VoicePtrLow:		defb	; low byte of custom voice table (for SFX)
VoicePtrHigh:		defb	; high byte of custom voice table (for SFX)
VoiceTLBuffer:		defs 4

LoopCounters:		defs 10	; Loop counter index 0
GoSubStack:			; start of next track, every two bytes below this is a coord flag "gosub" (F8h) return stack
len:
	ENDS

	STRUCT zVar
DACEnabled:		defb
MusicBankNumber:	defb
IsPalFlag:		defb		; slow song

TempoTimeout:		defb
CurrentTempo:		defb		; Stores current tempo value here
TempoMod:		defb
TempoTurbo:		defb		; Stores the tempo if speed shoes are acquired (or 7Bh is played anywho)
SpeedUpFlag:		defb

FadeOutCounter:		defb
FadeOutDelay:		defb
FadeInFlag:		defb
FadeInDelay:		defb
FadeInCounter:		defb
len:
	ENDS

zRamStart:
zStackEnd:		defs 64
zStack:

zCommunication:		defs 1
zQueueSlot1:		defs 1
zQueueSlot2:		defs 1
zQueueSlot3:		defs 1

zDoSFXFlag:		defs 1		; Flag to indicate we're updating SFX (and thus use custom voice table); set to FFh while doing SFX, 0 when not.
zDACUpdating:		defs 1		; Set to FFh while DAC is updating, then back to 00h
zPcmQueue:		defs 1
zPcmBank:		defs 1
zPcmSfxFlag:		defs 1

zClearRange:
zPlaying1upFlag:	defs 1
zSpindashTimer:		defs 1
zSpindashIndex:		defs 1
zStopMusic:		defs 1		; Set to 7Fh to pause music, set to 80h to unpause. Otherwise 00h
zPaused:		defs 1		; 0 = normal, -1 = pause all sound and music
zSFXPriorityVal:	defs 1

zMusClearRange:
zPALUpdTick:		defs 1		; This counts from 0 to 5 to periodically "double update" for PAL systems (basically every 6 frames you need to update twice to keep up)

zAbsVar:		zVar

zTracksStart:		; This is the beginning of all BGM track memory
zSongDAC:		zTrack
zSongFM1:		zTrack
zSongFM2:		zTrack
zSongFM3:		zTrack
zSongFM4:		zTrack
zSongFM5:		zTrack
zSongFM6:		zTrack
zSongPSG1:		zTrack
zSongPSG2:		zTrack
zSongPSG3:		zTrack
zTracksEnd:

zTracksSFXStart:
zSFX_FM3:		zTrack
zSFX_FM4:		zTrack
zSFX_FM5:		zTrack
zSFX_PSG1:		zTrack
zSFX_PSG2:		zTrack
zSFX_PSG3:		zTrack
zTracksSFXEnd:

zTracksSaveStart:	; When extra life plays, it backs up a large amount of memory (all track data plus 36 bytes)
zSaveVar:		zVar
zSaveSongDAC:		zTrack
zSaveSongFM1:		zTrack
zSaveSongFM2:		zTrack
zSaveSongFM3:		zTrack
zSaveSongFM4:		zTrack
zSaveSongFM5:		zTrack
zSaveSongFM6:		zTrack
zSaveSongPSG1:		zTrack
zSaveSongPSG2:		zTrack
zSaveSongPSG3:		zTrack
zTracksSaveEnd:

zRamEnd:
	valfor68k smps_commbyte		,zCommunication
	valfor68k smps_queue1		,zQueueSlot1
	valfor68k smps_queue2		,zQueueSlot2
	valfor68k smps_queue3		,zQueueSlot3
	valfor68k smps_pcmqueue		,zPcmQueue
	valfor68k smps_pcmsfxflag	,zPcmSfxFlag
	valfor68k smps_pauseflag	,zStopMusic

		STRUCT zData
bgmplaylist	defw
pcmtable	defw
volenv		defw
sfxbank		defb
sfxloc		defw
musid_first	defb
musid_last	defb
sfxid_first	defb
sfxid_last	defb
musid_1up	defb
segalen		defw
segaloc		defw
segabank	defb
segarate	defb
		ENDS
zDataTable:	zData
	valfor68k smps_datatable	,zDataTable
; ===========================================================================
		org	0
zEntryPoint:
	di
	ld	sp,zStack
	jp	zInitDriver
zPalModeByte:	db 0
	valfor68k smps_palflag		,zPalModeByte
; ---------------------------------------------------------------------------
	rstalign
zWriteFMIorII:
	bit	2,(ix+zTrack.VoiceControl)
	jp	NZ,zWriteFMII			; 10
	nop					; 4, fall into zWriteFMI
; ---------------------------------------------------------------------------
	rstalign
zWriteFMI:
	; Write reg/data pair to part I; 'a' is register, 'c' is data
	ld	(zYM2612_A0),a
	push	af
	ld	a,c
	ld	(zYM2612_D0),a
	pop	af
	ret
; ---------------------------------------------------------------------------
	rstalign
zWriteFMII:
	; Write reg/data pair to part II; 'a' is register, 'c' is data
	ld	(zYM2612_A1),a
	push	af
	ld	a,c
	ld	(zYM2612_D1),a
	pop	af
	ret
; ---------------------------------------------------------------------------
	block 38h-$
zVInt:
	; This is called every VBLANK (38h is the interrupt entry point,
	; and VBLANK is the only one Z80 is hooked up to.)
	push	af						; Save 'af'
	exx							; Effectively backs up 'bc', 'de', and 'hl'

	xor	a						; Clear 'a'
	ld	(zDoSFXFlag),a					; Not updating SFX (updating music)
	ld	ix,zAbsVar					; ix points to zAbsVar
	ld	a,(zStopMusic)					; Get pause/unpause flag
	or	a
	jr	Z,.notstopped
	call	zPauseMusic
	jp	zUpdateDAC					; Now update the DAC
.notstopped:
	call	zBankSwitchToMusic
	ld	a,(zAbsVar.FadeOutCounter)
	or	a
	call	NZ,zUpdateFadeout
	ld	a,(zAbsVar.FadeInFlag)
	or	a
	call	NZ,zUpdateFadeIn
	ld	a,(zSpindashTimer)
	or	a
	jr	Z,.spindash					; if the spindash counter is already 0, branch
	dec	a						; decrease the spindash sound playing counter
	ld	(zSpindashTimer),a
.spindash:
	call	zCycleQueue

; Update BGM
	call	zBankSwitchToMusic
	; If the system is PAL and the song doesn't opt out, update the song at 1.2x speed
	ld	hl,zPalModeByte					; Get address of zPalModeByte
	ld	a,(zAbsVar.IsPalFlag)				; Get IsPalFlag -> 'a'
	and	(hl)						; 'And' them together
	jr	Z,.paltimer					; If it comes out zero, do nothing
	ld	hl,zPALUpdTick
	dec	(hl)
	jr	NZ,.paltimer
	ld	(hl),5						; every 6 frames (0-5) you need to "double update" to sort of keep up
	call	zUpdateMusic
.paltimer:
	call	zUpdateMusic

; Update SFX
	call	zBankSwitchToSFX				; Bank switch to sound effects
	ld	a,1						; Updating SFX
	ld	(zDoSFXFlag),a

	ld	b,(zSFX_PSG1-zSFX_FM3)/zTrack.len		; Only 3 FM channels for SFX (FM3, FM4, FM5)
.fmloop:
	push	bc	
	ld	de,zTrack.len					; Spacing between tracks
	add	ix,de						; Next track
	bit	playback_playing,(ix+zTrack.PlaybackControl)	; Is it playing?
	call	NZ,zFMUpdateTrack				; If it is, go update it
	pop	bc
	djnz	.fmloop

	ld	b,(zTracksSFXEnd-zSFX_PSG1)/zTrack.len		; All PSG channels available
.psgloop:
	push	bc
	ld	de,zTrack.len					; Spacing between tracks
	add	ix,de						; Next track
	bit	playback_playing,(ix+zTrack.PlaybackControl)	; Is it playing?
	call	NZ,zPSGUpdateTrack				; If it is, go update it
	pop	bc
	djnz	.psgloop

	; Now we update the DAC... this only does anything if there's a new DAC 
	; sound to be played.  This is called after updating the DAC track.
	; Otherwise it just mucks with the timing loop, forcing an update.
zUpdateDAC:
	ld	a,2Ah
	ld	(zYM2612_A0),a
	ld	iyh,zDACDecodeTbl>>8				; UNDOC

	ld	a,(zPcmQueue)					; Get currently playing DAC sound
	or	a
	jr	NZ,.newdac					; If one is queued, go to it!
	ld	a,(zPcmBank)
	call	zBankSwitch					; Bankswitch to the DAC data
	exx
	pop	af
	ld	b,1
	ei
	ret
.newdac:
	; If you get here, it's time to start a new DAC sound...
	ld	e,a
	dec	e
	xor	a
	ld	d,a
	ld	(zPcmQueue),a

;	exx
	pop	af
	ld	hl,zWriteToDAC.start				; manipulate stack to the start of the sample playback routine
	ex	(sp),hl

	ld	hl,(zDataTable.pcmtable)
	add	hl,de
	add	hl,de
	add	hl,de
	add	hl,de
	add	hl,de
	add	hl,de

	ex	af,af'
	ld	a,(hl)
	inc	hl
	ex	hl,de
	ld	(zPcmBank),a
	call	zBankSwitch
	ex	hl,de
	ld	a,80h						; reset DPCM encodings "d" register, which is shadow register 'a'
	ex	af,af'

	ld	b,1
	ld	c,(hl)
	inc	hl

	ld	e,(hl)
	inc	hl
	ld	d,(hl)
	inc	hl

	ld	b,(hl)
	inc	hl
	ld	h,(hl)
	ld	l,b

	ei
	ret
; End of function zVInt


; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||

; Updates all tracks; queues notes and durations!

;zsub_110
zUpdateMusic:
	; S3K tempo algorithm
	; Tempo works as divisions of the 60Hz clock
	; (there is a separate fix supplied for PAL that "kind of" keeps it on track)
	; Every time the internal music clock overflows, it's halted by one tick
	; So a tempo of 00h will update every frame, 80h will update every 2 frames, CCh will update every 5 out of 6 frames
	ld	a,(zAbsVar.CurrentTempo)
	ld	hl,zAbsVar.TempoTimeout
	add	a,(hl)
	ld	(hl),a
	jr	NC,.exit					; If addition doesn't overflow, exit
	ld	hl,zTracksStart+zTrack.DurationTimeout		; Start at first track's delay counter (counting up to delay)
	ld	de,zTrack.len					; Offset between tracks 
	ld	b,(zTracksEnd-zTracksStart)/zTrack.len		; Loop for all tracks
.loop:	inc	(hl)						; Increasing delay tick counter to target
	add	hl,de						; Next track...
	djnz	.loop
.exit:
	ld	a,0FFh
	ld	(zDACUpdating),a

counter defl zSongDAC
	rept (zSongFM1-zSongDAC)/zTrack.len
	ld	ix,counter
	bit	playback_playing,(ix+zTrack.PlaybackControl)
	call	NZ,zDACUpdateTrack
counter defl counter + zTrack.len
	endr

	xor	a
	ld	(zDACUpdating),a

counter defl zSongFM1
	rept (zSongPSG1-zSongFM1)/zTrack.len
	ld	ix,counter
	bit	playback_playing,(ix+zTrack.PlaybackControl)
	call	NZ,zFMUpdateTrack
counter defl counter + zTrack.len
	endr

counter defl zSongPSG1
	rept (zTracksEnd-zSongPSG1)/zTrack.len
	ld	ix,counter
	bit	playback_playing,(ix+zTrack.PlaybackControl)
	call	NZ,zPSGUpdateTrack
counter defl counter + zTrack.len
	endr

	ret
; ---------------------------------------------------------------------------

zInitDriver:
	im	1
	call	zClearTrackPlaybackMem
	ei
.wait:	jr	.wait

; DPCM sample playback.
; It starts with a value of 80h (mute) and adds a value represented by a 4-bit offset into a table
; This is a lossy compression, as it cannot represent every sequence of a PCM and doesn't even try to
; However at a high enough Hz rate, you'd likely not be able to tell the difference
; Hz is measured in Z80 CPU cycles, 1+(Z80_Clock/(samplerate)-(smps_pcmcycle)+(13/2))/13
; INPUT
; a' = sample (starts at 80h)
; b = sample rate (djnz waitloop)
; c = copy of sample rate
; de = sample length
; hl = sample pointer
; iy = DPCM decode table
; NOTES:
; 1. Interrupts can't be disabled for any longer then ~70 cycles (TODO: get exact number from MPCM2 doc)
; 2. For clean playback, the amount of time between each sample should be consistent
; 3. Regarding cycle counts: According to Kabuto, the Z80 suffers a delay of approximately 3.3 cycles for each ROM access.
;    https://plutiedev.com/mirror/kabuto-hardware-notes#bus-system
; 4. When restoring from vblank into playback, you need to run the following:
;	push	af
;	exx
;	...
;	ld	a,2Ah
;	ld	(zYM2612_A0),a
;	ld	iyh,zDACDecodeTbl>>8				; UNDOC
;	ld	a,(.currbank)
;	call	zBankSwitch
;	exx
;	pop	af
;	ld	b,1
;	ei
zWriteToDAC:
.start:
;	ld	a,2Ah
;	ld	(zYM2612_A0),a
;	ld	iyh,zDACDecodeTbl>>8				; UNDOC
.loop:
	djnz	$					; 8,13l	; Busy wait for specific amount of time in 'b'
	di						; 4	; disable interrupts (while updating DAC)
	ld	a,(hl)					; 7+3	; Get next DAC byte
	ld	b,a					; 4	; save for next byte
	rlca						; 4	;
	rlca						; 4	;
	rlca						; 4	;
	rlca						; 4	;
	and	0Fh					; 7	; UPPER 4-bit offset into zDACDecodeTbl
						; 45+13l
	ld	iyl,a					; 8	; UNDOC ; use as an index (256 aligned)
	ex	af,af'					;'4	; shadow register 'a' is the 'd' value for 'jman2050' encoding
	add	a,(iy+0)				; 19	; Get byte from zDACDecodeTbl
	ld	(zYM2612_D0),a				; 13	; Write this byte to the DAC
	ex	af,af'					;'4	; back to regular registers
	ld	a,b					; 4	; Get next DAC byte
	ld	b,c					; 4	; reload 'b' with wait value
	ei						; 4	; enable interrupts (done updating DAC, busy waiting for next update)
	inc	hl					; 6	; Next byte in DAC stream...
	nop						; 4	; stall
	nop						; 4	; stall
						; 74
						; 119 total
	djnz	$					; 8,13l	; Busy wait for specific amount of time in 'b'
	di						; 4	; disable interrupts (while updating DAC)
	and	0Fh					; 7	; LOWER 4-bit offset into zDACDecodeTbl
	dec	de					; 6	; One less byte
	bit	7,h					; 8	;
	jr	NZ,.dobank				; 12	;
	push	af						; this'll lead to a small dip in the Hz rate... for one sample, every ~65000 samples
	ld	hl,zPcmBank					; TODO: calculate how big that dip is
	inc	(hl)
	ld	a,(hl)
	ld	hl,zBankRegister
	rept 7
	ld	(hl),a
	rrca
	endr
	ld	(hl),a
	ld	(hl),h
	pop	af
	ld	hl,zROMWindow
.dobank:					; 45+13l
	ld	iyl,a					; 8	; UNDOC ; use as an index (256 aligned)
	ex	af,af'					;'4	; shadow register 'a' is the 'd' value for 'jman2050' encoding
	add	a,(iy+0)				; 19	; Get byte from zDACDecodeTbl
	ld	(zYM2612_D0),a				; 13	; Write this byte to the DAC
	ex	af,af'					;'4	; back to regular registers
	ld	b,c					; 4	; reload 'b' with wait value
	ei						; 4	; enable interrupts (done updating DAC, busy waiting for next update)
	ld	a,d					; 4	;
	or	e					; 4	;
	jp	NZ,.loop				; 10	; If 'de' (length of sample) isn't 0, loop...
						; 74
						; 119 total
	di
	xor	a						; if it's a SFX clear it
	ld	(zPcmSfxFlag),a
	ld	a,80h						; mute DAC
	ld	(zYM2612_D0),a
	ei
.wait:	jr	.wait						; wait until pcm is queued (it'll manipulate stack to zWriteToDAC.start)
	valfor68k smps_dpcmcycle,119
; ---------------------------------------------------------------------------
zGetMusicTrackOffset:
	add	a,zMusicTrackOffs&$FF	; table+index
	ld	l,a
	adc	a,zMusicTrackOffs>>8
	sub	l
	ld	h,a
	ld	a,(hl)			; get pointer
	inc	hl
	ld	h,(hl)
	ld	l,a
	ret

; 'jman2050' DAC decode lookup table
	align 100h
zDACDecodeTbl:
	db	   0,    1,   2,   4,   8,  10h,  20h,  40h
	db	 80h,   -1,  -2,  -4,  -8, -10h, -20h, -40h
	
	; The following two tables are used for when an SFX terminates
	; its track to properly restore the music track it temporarily took
	; over.  Note that an important rule here is that no SFX may use
	; DAC, FM Channel 1, FM Channel 2, or FM Channel 6, period.
	; Thus there's also only SFX tracks starting at FM Channel 3.
	
	; The zeroes appear after FM 3 because it calculates the offsets into
	; these tables by their channel assignment, where between Channel 3
	; and Channel 4 there is a gap numerically.

zMusicTrackOffs:
	; These are offsets to different music tracks starting with FM3
	dw	zSongFM3,      0000h,  zSongFM4,  zSongFM5	; FM3, 0, FM4, FM5
	dw	zSongPSG1, zSongPSG2, zSongPSG3, zSongPSG3	; PSG1, PSG2, PSG3, PSG3 (noise alternate)
zSFXTrackOffs:
	; These are offsets to different sound effect tracks starting with FM3
	dw	zSFX_FM3,      0000h,  zSFX_FM4,  zSFX_FM5	; FM3, 0, FM4, FM5
	dw	zSFX_PSG1, zSFX_PSG2, zSFX_PSG3, zSFX_PSG3	; PSG1, PSG2, PSG3, PSG3 (noise alternate)
; ---------------------------------------------------------------------------
zPlaySegaChant:
	di
	push	ix
	ld	a,0B6h				; set DAC panning to mono
	ld	c,0C0h
	rst	zWriteFMII
	ld	a,2Bh				; enable DAC
	ld	c,80h
	rst	zWriteFMI

	ld	hl,(zDataTable.segaloc)
	ld	de,(zDataTable.segalen)
	ld	a,(zDataTable.segarate)
	ld	c,a
	ld	a,(zDataTable.segabank)
	ld	ixh,a
	call	zBankSwitch

	ld	a,2Ah				; play samples
	ld	(zYM2612_A0),a
.loop:
	ld	a,(hl)				; 7	; Get next PCM byte
	ld	(zYM2612_D0),a			; 13	; Send to DAC
	ld	b,c				; 4	; Set delay time
	djnz	$				; 8	; Delay

	ld	a,(zQueueSlot1)			; 13	; Check if the first queue slot has anything
	or	a				; 4
	jr	nz,.stop			; 7	; If it does, stop Sega PCM

	inc	hl				; 6	; Increment pointer
	bit	7,h				; 8
	jp	NZ,.inbank			; 10
	inc	ixh					; 8
	ld	a,ixh					; 8
	ld	h,zBankRegister>>8			; 7
	rept 7
	ld	(hl),a					; 7
	rrca						; 4
	endr
	ld	(hl),a					; 7
	ld	(hl),h					; 7
	ld	h,zROMWindow>>8				; 7
							; +121
.inbank:
	dec	de				; 6	; Decrement timer
	ld	a,d				; 4	; Check if the timer is zero
	or	e				; 4
	jp	nz,.loop			; 10	; If not, loop
						; 104 total, 225 when crossing a bank
.stop:
	pop	ix
	ld	a,2Ah				; mute sample
	ld	c,80h
	rst	zWriteFMI
	ld	a,2Bh				; either enable or disable the DAC
	ld	c,(ix+zVar.DACEnabled)
	rst	zWriteFMI
	ei
	jp	zBankSwitchToMusic
	valfor68k smps_segacycle,104
; ---------------------------------------------------------------------------

zDACUpdateTrack:
	dec	(ix+zTrack.DurationTimeout)			; Subtract 1 from (zTracksStart+0Bh) [Track 1's delay start]
	ret	NZ						; Return if not zero yet
	ld	l,(ix+zTrack.DataPointerLow)			; Low byte of DAC track current address (zTracksStart+3)
	ld	h,(ix+zTrack.DataPointerHigh)			; High byte of DAC track current address (zTracksStart+4)
.coordloop:
	ld	a,(hl)						; Get next byte from DAC Track
	inc	hl						; Move to next position...
	cp	0E0h						; Check if is coordination flag
	jr	C,.notcoord					; Not coord flag?  Skip to '+'
	call	zCoordFlag					; Handle coordination flag
	jp	.coordloop					; Loop back around...
.notcoord:
	or	a						; Test 'a' for 80h not set, which is a note duration
	jp	P,.time						; If note duration, jump (note that "hl" is already incremented)
	ld	(ix+zTrack.SavedDAC),a				; This is a note; store it here 
	ld	a,(hl)						; Get next byte...
	or	a						; Test 'a' for 80h not set, which is a note duration
	jp	P,.notetime					; Is this a duration this time?? If so, jump to zloc_20D (only difference is to increment "hl")
	; Note followed a note... apparently recycles the previous duration
	ld	a,(ix+zTrack.SavedDuration)			; Current DAC note ticker goal value -> 'a'
	ld	(ix+zTrack.DurationTimeout),a			; Use it again
	jr	zDACAfterDur					; Jump to after duration subroutine...
.notetime:
	inc	hl						; Goes to next byte (after duration byte)
.time:
	call	zSetDuration

;zloc_211
zDACAfterDur:
	ld	(ix+zTrack.DataPointerLow),l			; Stores "hl" to the DAC track pointer memory
	ld	(ix+zTrack.DataPointerHigh),h
	bit	playback_override,(ix+zTrack.PlaybackControl)	; Is SFX overriding this track?
	ret	NZ						; If so, we're done
	ld	a,(ix+zTrack.SavedDAC)				; Check next note to play
	ld	c,a
	ld	a,(zPcmSfxFlag)					; if a PCM SFX is playing, don't interrupt it
	or	a
	ret	NZ
	ld	a,c
	sub	80h						; Is it a rest?
	ret	Z						; If so, quit
;	ret	C
	ld	(zPcmQueue),a					; Store current DAC sound to play
	ret

; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||


;zsub_237
zFMUpdateTrack:
	dec	(ix+zTrack.DurationTimeout)			; Decrement duration
	jr	NZ,.update					; If not time-out yet, go do updates only
	res	playback_noattack,(ix+zTrack.PlaybackControl)	; When duration over, clear "do not attack" bit 4 (0x10) of track's play control
	call	zFMDoNext					; Handle coordination flags, get next note and duration
	call	zFMPrepareNote					; Prepares to play next note
	call	zFMNoteOn					; Actually key it (if allowed)
	call	zDoVolume					; This applies PSG volume as well as its special volume-based effects that I call "flutter"
	call	zDoModulation					; Update modulation (if modulation doesn't change, we do not return here)
	jp	zFMUpdateFreq					; Applies frequency update from modulation
.update:
	call	zNoteFillUpdate					; Applies "note fill" (time until cut-off); NOTE: Will not return here if "note fill" expires
	call	zUpdateVolEnv					; Update volume effects
	call	zDoModulation					; Update modulation (if modulation doesn't change, we do not return here)
	jp	zFMUpdateFreq					; Applies frequency update from modulation
; End of function zFMUpdateTrack


; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||


;zsub_258
zFMDoNext:
	ld	l,(ix+zTrack.DataPointerLow)			; Load track position low byte
	ld	h,(ix+zTrack.DataPointerHigh)			; Load track position high byte
	res	playback_resting,(ix+zTrack.PlaybackControl)	; Clear bit 1 (02h) "track is rest" from track
.coordloop:
	ld	a,(hl)						; Get next byte from DAC Track
	inc	hl						; Move to next position...
	cp	0E0h						; Check if is coordination flag
	jr	C,.notcoord					; Not coord flag?  Skip to '+'
	call	zCoordFlag					; Handle coordination flag
	jp	.coordloop					; Loop back around...
.notcoord:
	push	af
	call	zFMNoteOff					; Send key off
	pop	af
	or	a						; Test 'a' for 80h not set, which is a note duration
	jp	P,.note						; If duration, jump to '+'
	call	zFMSetFreq					; Otherwise, this is a note; call zFMSetFreq
	ld	a,(hl)						; Get next byte
	or	a						; Test 'a' for 80h set, which is a note
	jp	M,zFinishTrackUpdate				; If this is a note, jump to zFinishTrackUpdate
	inc	hl						; Otherwise, go to next byte; a duration
.note:
	call	zSetDuration
	jp	zFinishTrackUpdate				; Either way, jumping to zFinishTrackUpdate...
; End of function zFMDoNext

; ---------------------------------------------------------------------------
; zloc_285:
;zGetFrequency
zFMSetFreq:
	; 'a' holds a note to get frequency for
	sub	80h
	jr	Z,.rest						; If this is a rest, jump to zFMDoRest
	add	a,(ix+zTrack.Transpose)				; Add current channel transpose (coord flag E9)
	add	a,a						; Offset into Frequency table...

	ld	d,12*2						; 12 notes per octave
	ld	c,0						; clear c (will hold octave bits)

.find:	sub	d						; Subtract 1 octave from the note
	jr	C,.found					; If this is less than zero, we are done
	inc	c						; One octave up
	jr	.find
.found:
	add	a,d						; Add 1 octave back (so note index is positive)
	sla	c
	sla	c
	sla	c						; multiply octave value by 8, to get final octave bits

	add	a,zFMFrequencies&$FF
	ld	(.freq+2),a					; (self-modifying code)
	ld	d,a
	adc	a,zFMFrequencies>>8
	sub	d
	ld	(.freq+3),a					; (self-modifying code)
.freq:	ld	de,(zFMFrequencies)				; Store frequency into "de" (self-modified code)
	ld	(ix+zTrack.FreqLow),e
	ld	a,d
	or	c
	ld	(ix+zTrack.FreqHigh),a
	ret
.rest:
	set	playback_resting,(ix+zTrack.PlaybackControl)	; Set bit 1 (track is at rest)
	xor	a						; Clear 'a'
	ld	(ix+zTrack.FreqLow),a				; Zero out FM Frequency
	ld	(ix+zTrack.FreqHigh),a				; Zero out FM Frequency
	ret

; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||


;zsub_2A9
zSetDuration:
	ld	c,a						; 'a' = current duration
	ld	b,(ix+zTrack.TempoDivider)			; Divisor; causes multiplication of duration for every number higher than 1
.loop:
	djnz	.mul
	ld	(ix+zTrack.SavedDuration),a			; Store new duration into ticker goal of this track (this is reused if a note follows a note without a new duration)
	ld	(ix+zTrack.DurationTimeout),a			; Sets it on ticker (counts to zero)
	ret
.mul:
	add	a,c						; Will multiply duration based on 'b'
	jp	.loop
; End of function zSetDuration

; ---------------------------------------------------------------------------

;zloc_2BA
zFinishTrackUpdate:
	; Common finish-up routine used by FM or PSG
	ld	(ix+zTrack.DataPointerLow),l			; Stores "hl" to the track pointer memory
	ld	(ix+zTrack.DataPointerHigh),h
	ld	a,(ix+zTrack.SavedDuration)			; Last set duration
	ld	(ix+zTrack.DurationTimeout),a			; ... put into ticker
	bit	playback_noattack,(ix+zTrack.PlaybackControl)	; Is bit 4 (10h) "do not attack next note" set on playback?
	ret	NZ						; If so, quit
	ld	a,(ix+zTrack.NoteFillMaster)			; Master "note fill" value -> a
	ld	(ix+zTrack.NoteFillTimeout),a			; Reset 0Fh "note fill" value to master
	ld	(ix+zTrack.VolEnvIndex),0			; Reset PSG flutter byte
	ld	a,(ix+zTrack.ModulationCtrl)			; is modulation turned on?
	or	a
	ret	Z						; if not, quit
	ld	l,(ix+zTrack.ModulationPtrLow)			; Otherwise, get address of modulation setting
	ld	h,(ix+zTrack.ModulationPtrHigh)
	jp	zSetModulation					; ... and go do it!

; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||


;zsub_2E3
zNoteFillUpdate:
	ld	a,(ix+zTrack.NoteFillTimeout)			; Get current note fill value
	or	a
	ret	Z						; If zero, return!
	dec	(ix+zTrack.NoteFillTimeout)			; Decrement note fill
	ret	NZ						; If not zero, return
	set	playback_resting,(ix+zTrack.PlaybackControl)	; Set bit 1 (track is at rest)
	pop	de						; return address -> 'de' (will not return to z*UpdateTrack function!!)
	bit	7,(ix+zTrack.VoiceControl)			; Is this a PSG track?
	jp	NZ,zPSGNoteOff					; If so, jump to zPSGNoteOff
	jp	zFMNoteOff					; Else, jump to zFMNoteOff
; End of function zNoteFillUpdate


; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||


;zsub_2FB
zDoModulation:
	pop	de						; keep return address -> de (MAY not return to caller)
	
	bit	playback_resting,(ix+zTrack.PlaybackControl)	; Is "track in rest"?
	ret	NZ						; If so, quit
	ld	a,(ix+zTrack.ModulationCtrl)			; is modulation turned on?
	or	a
	ret	Z						; If not, quit
	ld	a,(ix+zTrack.ModulationWait)			; 'ww' period of time before modulation starts
	or	a
	jr	Z,.mod1						; if zero, go to it!
	dec	(ix+zTrack.ModulationWait)			; Otherwise, decrement timer
	ret							; return if decremented (does NOT return to z*UpdateTrack!!)
.mod1:
	dec	(ix+zTrack.ModulationSpeed)			; Decrement modulation speed counter
	ret	NZ						; Return if not yet zero
	ld	l,(ix+zTrack.ModulationPtrLow)
	ld	h,(ix+zTrack.ModulationPtrHigh)			; 'hl' points to modulation setting
	inc	hl						; skip passed 'ww' period of time
	ld	a,(hl)						; Get modulation speed
	ld	(ix+zTrack.ModulationSpeed),a			; Restore speed counter
	ld	a,(ix+zTrack.ModulationSteps)			; Get number of steps in modulation
	or	a
	jr	NZ,.mod2					; If not zero, skip to '+'
	
	; If steps have reached zero...
	inc	hl						; passed mod speed
	inc	hl						; passed mod change per mod step
	ld	a,(hl)						; get number of steps in modulation
	ld	(ix+zTrack.ModulationSteps),a			; restore modulation steps
	ld	a,(ix+zTrack.ModulationDelta)			; get modulation change per mod step
	neg							; flip it negative
	ld	(ix+zTrack.ModulationDelta),a			; store negated value
	ret
.mod2:
	dec	(ix+zTrack.ModulationSteps)			; Decrement the step
	ld	l,(ix+zTrack.ModulationValLow)		
	ld	h,(ix+zTrack.ModulationValHigh)			; Get 16-bit modulation value
	
	; This is a 16-bit sign extension for 'bc'
	ld	a,(ix+zTrack.ModulationDelta)			; Get current modulation change per step -> 'a'
	ld	c,a
	rla							; Carry contains sign of delta
	sbc	a,a						; a = 0 or -1 if carry is 0 or 1
	ld	b,a						; bc = sign extension of delta
	add	hl,bc						; Add to current modulation value
	ld	(ix+zTrack.ModulationValLow),l
	ld	(ix+zTrack.ModulationValHigh),h			; Store new 16-bit modulation value
	ld	c,(ix+zTrack.FreqLow)				; frequency low byte -> c
	ld	b,(ix+zTrack.FreqHigh)				; frequency high byte -> b
	add	hl,bc						; Add modulation value
	ex	de,hl
	jp	(hl)						; WILL return to z*UpdateTrack
; End of function zDoModulation

; ---------------------------------------------------------------------------
; S3K driver PSG table, allows it to span notes c-0 to b-7.
zPSGFrequencies:
	dw	3FFh, 3FFh, 3FFh, 3FFh, 3FFh, 3FFh, 3FFh, 3FFh, 3FFh, 3F7h, 3BEh, 388h
	dw	356h, 326h, 2F9h, 2CEh, 2A5h, 280h, 25Ch, 23Ah, 21Ah, 1FBh, 1DFh, 1C4h
	dw	1ABh, 193h, 17Dh, 167h, 153h, 140h, 12Eh, 11Dh, 10Dh, 0FEh, 0EFh, 0E2h
	dw	0D6h, 0C9h, 0BEh, 0B4h, 0A9h, 0A0h, 097h, 08Fh, 087h, 07Fh, 078h, 071h
	dw	06Bh, 065h, 05Fh, 05Ah, 055h, 050h, 04Bh, 047h, 043h, 040h, 03Ch, 039h
	dw	036h, 033h, 030h, 02Dh, 02Bh, 028h, 026h, 024h, 022h, 020h, 01Fh, 01Dh
	dw	01Bh, 01Ah, 018h, 017h, 016h, 015h, 013h, 012h, 011h, 010h, 000h, 000h
; ---------------------------------------------------------------------------

;zloc_3E5
zFMPrepareNote:
	bit	playback_resting,(ix+zTrack.PlaybackControl)	; Is track in rest?
	ret	NZ						; If so, quit
	ld	e,(ix+zTrack.FreqLow)				; Get frequency low
	ld	d,(ix+zTrack.FreqHigh)				; Get frequency high
	ld	a,d
	or	e
	jp	Z,zRestTrack					; If frequency is zero, rest the track

;zloc_3F5
zFMUpdateFreq:
	bit	playback_override,(ix+zTrack.PlaybackControl)	; Is SFX overriding this track?
	ret	NZ						; If so, quit!
	; This is a 16-bit sign extension of (ix+19h)
	ld	a,(ix+zTrack.Detune)				; Get detune value
	ld	l,a
	rla							; Carry contains sign of detune
	sbc	a,a						; a = 0 or -1 if carry is 0 or 1
	ld	h,a						; hl = sign extension of detune
	add	hl,de						; Alter frequency just a tad
	ld	c,h						; Upper part of frequency as data to FM ('c')
	ld	a,(ix+zTrack.VoiceControl)			; "voice control" byte -> 'a'
	and	3						; Strip to only channel assignment 
	add	a,0A4h						; Change to proper register
	rst	zWriteFMIorII					; Write it!
	ld	c,l						; lower part of frequency
	sub	4						; A0h+ register
	rst	zWriteFMIorII					; Write it!
	ret

; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||


;zsub_414
zPSGUpdateTrack:
	dec	(ix+zTrack.DurationTimeout)			; decrement current duration timeout..
	jr	NZ,.update					; If not time-out yet, go do updates only
	res	playback_noattack,(ix+zTrack.PlaybackControl)	; Reset "do not attack next note" bit
	call	zPSGDoNext					; Handle coordination flags, get next note and duration
	call	zPSGDoNoteOn					; Actually key it (if allowed)
	call	zDoVolume					; This applies PSG volume as well as its special volume-based effects that I call "flutter"
	call	zDoModulation					; Update modulation (if modulation doesn't change, we do not return here)
	jp	zPSGUpdateFreq
.update:
	call	zNoteFillUpdate					; Applies "note fill" (time until cut-off); NOTE: Will not return here if "note fill" expires
	call	zUpdateVolEnv					; Update volume effects
	call	zDoModulation					; Update modulation (if modulation doesn't change, we do not return here)
	jp	zPSGUpdateFreq
; End of function zPSGUpdateTrack


; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||


;zsub_438
zPSGDoNext:
	ld	l,(ix+zTrack.DataPointerLow)			; Load track position low byte
	ld	h,(ix+zTrack.DataPointerHigh)			; Load track position high byte
	res	playback_resting,(ix+zTrack.PlaybackControl)	; Clear bit 1 (02h) "track is rest" from track
.coordloop:
	ld	a,(hl)						; Get next byte from DAC Track
	inc	hl						; Move to next position...
	cp	0E0h						; Check if is coordination flag
	jr	C,.notcoord					; Not coord flag?  Skip to '+'
	call	zCoordFlag					; Handle coordination flag
	jp	.coordloop					; Loop back around...
.notcoord:
	or	a						; Test 'a' for 80h not set, which is a note duration
	jp	P,.note						; If note duration, jump to '+'
	call	zPSGSetFreq					; Get frequency for this note
	ld	a,(hl)						; Get next byte
	or	a						; Test 'a' for 80h set, which is a note
	jp	M,zFinishTrackUpdate				; If this is a note, jump to zFinishTrackUpdate
	inc	hl						; Otherwise, go to next byte; a duration
.note:
	call	zSetDuration
	jp	zFinishTrackUpdate				; Either way, jumping to zFinishTrackUpdate...
; End of function zPSGDoNext

; ---------------------------------------------------------------------------

;zloc_460
zPSGSetFreq:
	sub	81h						; a = a-$81 (zero-based index from lowest note)
	jr	C,.rest						; If carry (can only be $80) this is a rest!
	add	a,(ix+zTrack.Transpose)				; Add current channel transpose to note
	add	a,a						; Multiply note value by 2
	add	a,zPSGFrequencies&$FF
	ld	(.freq+2),a					; (self-modifying code)
	ld	d,a
	adc	a,zPSGFrequencies>>8
	sub	d
	ld	(.freq+3),a					; (self-modifying code)
.freq:	ld	de,(zPSGFrequencies)				; Store frequency into "de" (self-modified code)
	ld	(ix+zTrack.FreqLow),e
	ld	(ix+zTrack.FreqHigh),d
	ret
.rest:
	; If you get here, we're doing a PSG rest
	set	playback_resting,(ix+zTrack.PlaybackControl)	; Set "track in rest" bit
	ld	a,0FFh
	ld	(ix+zTrack.FreqLow),a				; Frequency low byte = FFh
	ld	(ix+zTrack.FreqHigh),a				; Frequency hight byte = FFh
	jp	zPSGNoteOff					; Send PSG Note Off

; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||


;zsub_487
zPSGDoNoteOn:
	bit	7,(ix+zTrack.FreqHigh)				; If track is at rest (frequency was set to FFh)...
	jr	NZ,zRestTrack					; ...rest the track
	ld	e,(ix+zTrack.FreqLow)				; Frequency low byte -> e
	ld	d,(ix+zTrack.FreqHigh)				; Frequency high byte -> d

;zloc_493
zPSGUpdateFreq:
	ld	a,(ix+zTrack.PlaybackControl)			; Get playback control byte
	and	1<<playback_resting|1<<playback_override
	ret	NZ						; If either bit 1 ("track in rest") and 2 ("SFX overriding this track"), quit!
	; This is a 16-bit sign extension of (ix+19h) -> 'hl'
	ld	a,(ix+zTrack.Detune)				; Get detune value
	ld	l,a
	rla							; Carry contains sign of detune
	sbc	a,a						; a = 0 or -1 if carry is 0 or 1
	ld	h,a						; hl = sign extension of detune
	add	hl,de						; Alter frequency just a tad
	; This picks out the reg to write to the PSG
	ld	a,(ix+zTrack.VoiceControl)			; Get "voice control" byte...
	cp	0E0h						; Is it E0h?
	jr	NZ,.notpsg4					; If not, skip next step
	ld	a,0C0h						; a = C0h instead of E0h
.notpsg4:
	ld	b,a						; 'a' -> 'b'
	ld	a,l						; Frequency low byte -> 'a'
	and	0Fh						; Keep only lower four bits (first PSG reg write only applies d0-d3 of freq)
	or	b						; Apply register bits
	ld	(zPSG),a					; Write it to PSG!
	ld	a,l						; Get frequency low byte -> 'a'
	srl	h						; (h >> 1); lowest bit into carry
	rra							; (a >> 1); carry from 'h' applied at end
	srl	h						; ... and so on ...
	rra
	rra
	rra							; in C, basically (hl >> 4) (except possible garbage from the rotation in upper bits)
	and	3Fh						; keep only lower 6 bits (PSG d4-d9)
	ld	(zPSG),a					; Write other frequency byte to PSG!
	ret
; ---------------------------------------------------------------------------

zRestTrack:
	set	playback_resting,(ix+zTrack.PlaybackControl)		; Set "track at rest" bit
	ret
; End of function zPSGDoNoteOn


; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||


;zsub_4CA
zUpdateVolEnv:
	ld	a,(ix+zTrack.VolEnvID)				; Get current PSG tone
	or	a						; Test if it's zero
	ret	Z						; If it is, return!
	; Otherwise, fall into zDoVolume...


; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||


;zsub_4CF
zDoVolume:
	ld	b,(ix+zTrack.Volume)				; Channel volume -> 'b'

zUpdateVolEnv_cont:
	ld	a,(ix+zTrack.VolEnvID)				; Current PSG tone -> 'a'
	or	a						; Test it
	jr	Z,zUpdateVolume					; If tone is zero, jump to zUpdateVolume

	ld	de,(zDataTable.volenv)				; hl points to zPSG_FlutterTbl table
	dec	a						; a--
	add	a,a						; a *= 2
	ld	l,a						; Get offset from volenv table
	ld	h,0
	add	hl,de
	ld	a,(hl)						; Add index from table into table
	inc	hl
	ld	h,(hl)
	ld	l,a
	add	hl,de
	ld	a,(ix+zTrack.VolEnvIndex)			; Add volenvindex
	ld	e,a
	ld	d,0
	add	hl,de						; table+offsetfromtable+index

	ld	a,(hl)						; Get volume envelope
	or	a						; test byte from before
	jp	P,.positivevol					; Is it a positive value?
	cp	80h						; Check if it's 80h (terminator to the "flutter" list)
	jr	Z,zVolEnvHold					; If it is, then jump to zVolEnvHold (which just keeps at this flutter value, i.e. no more changes in volume)
.positivevol:
	bit	7,(ix+zTrack.VoiceControl)			; adjust volenv (7-bit) for PSG (4-bit)
	jr	Z,.fm
	rra
	rra
	rra
	and	0Fh
.fm:
	inc	(ix+zTrack.VolEnvIndex)				; Increment index
	add	a,b						; Apply this "flutter" to channel volume -> 'a'
	ld	b,a						; a -> 'b'

; b = volume
zUpdateVolume:
	ld	a,(ix+zTrack.PlaybackControl)			; Get playback control byte
	and	1<<playback_resting|1<<playback_override
	ret	NZ						; If either bit 1 ("track in rest") and 2 ("SFX overriding this track"), quit!
	bit	playback_noattack,(ix+zTrack.PlaybackControl)	; is "do not attack next note" set?
	jr	Z,.attack					; If so, jump to zloc_515
; if notecut is on and has already cut the note, don't update volume
; TODO: merge both into one check
	ld	a,(ix+zTrack.NoteFillMaster)			; note cut on is non-zero
	or	a
	jr	Z,.attack
	ld	a,(ix+zTrack.NoteFillTimeout)			; note cut cut the note is zero
	or	a
	ret	Z
.attack:
	bit	7,(ix+zTrack.VoiceControl)			; branch if it's an FM track
	jp	Z,zSetFMTLs
.psg:
	ld	a,b						; 'b' -> 'a'
	cp	10h						; Did the level get pushed below silence level?
	jr	C,.capvol
	ld	a,0Fh						; If so, fix it!
.capvol:
	or	(ix+zTrack.VoiceControl)			; Apply channel info (which PSG to set!)
	or	10h						; This bit marks it as an attenuation level assignment (along with channel info just above)
	ld	(zPSG),a					; Write to PSG!!
	ret
; ---------------------------------------------------------------------------
; zloc_522:
zVolEnvHold:
	; This just decrements the flutter to keep it in place; no more volume changes in this list
	dec	(ix+zTrack.VolEnvIndex)				; Put index back (before final volume value)
	jr	zUpdateVolEnv_cont				; Loop back and update volume 
; End of function zDoVolume


; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||


;zsub_526
zPSGNoteOff:
	bit	playback_override,(ix+zTrack.PlaybackControl)	; Is "SFX override" bit set?
	ret	NZ						; If so, quit!
	ld	a,(ix+zTrack.VoiceControl)			; Get "voice control" byte (loads upper bits which specify attenuation setting)

	;                 |a| |1Fh|
	; VOL1    0x90	= 100 1xxxx	vol 4b xxxx = attenuation value
	; VOL2    0xb0	= 101 1xxxx	vol 4b
	; VOL3    0xd0	= 110 1xxxx	vol 4b
		
	or	1Fh						; Attenuation Off
	ld	(zPSG),a
	; Without zInitMusicPlayback forcefully muting all channels, there's the
	; risk of music accidentally playing noise because it can't detect if
	; the PSG4/noise channel needs muting, on track initialisation.
	; This bug can be heard be playing the End of Level music in CNZ, whose
	; music uses the noise channel. S&K's driver contains a fix just like this.
	cp	0DFh						; Are stopping PSG3?
	ret	NZ
	ld	a,0FFh						; If so, stop noise channel while we're at it
	ld	(zPSG),a					; Stop noise channel
	ret
; End of function zPSGNoteOff

; ---------------------------------------------------------------------------
; lookup table of FM note frequencies for instruments and sound effects
; zbyte_534:
zFMFrequencies:
	dw 	025Eh,0284h,02ABh,02D3h,02FEh,032Dh,035Ch,038Fh,03C5h,03FFh,043Ch,047Ch

;zloc_5F4
zPSGSilenceAll:
	ld	hl,zPSG		; PSG reg
	ld	(hl),9Fh	; Stop channel 0
	ld	(hl),0BFh	; Stop channel 1
	ld	(hl),0DFh	; Stop channel 2
	ld	(hl),0FFh	; Stop noise channel
	ret

; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
;zsub_600
zPauseMusic:
	jp	M,.unpause					; If we are to unpause music, branch
	ld	a,(zPaused)					; Get paused flag
	or	a						; Are we paused already?
	ret	NZ						; If so, return
	ld	a,0FFh						; a = 0FFh
	ld	(zPaused),a					; Set paused flag
	call	zFMSilenceAll
	jp	zPSGSilenceAll
.unpause
	xor	a						; a = 0
	ld	(zStopMusic),a					; Clear pause/unpause flag
	ld	(zPaused),a					; Clear paused flag

	call	zBankSwitchToMusic				; Bank switch to the music
	ld	ix,zTracksStart					; ix = pointer to track RAM
	ld	b,(zSongPSG1-zTracksStart)/zTrack.len		; 1 DAC + 6 FM
	call	zResumeTrack

	call	zBankSwitchToSFX				; Now for SFX
	ld	a,1						; Set flag to say we are updating SFX
	ld	(zDoSFXFlag),a
	ld	ix,zTracksSFXStart				; ix = pointer to SFX track RAM
	ld	b,(zSFX_PSG1-zTracksSFXStart)/zTrack.len	; 3 FM
	call	zResumeTrack
	xor	a						; a = 0
	ld	(zDoSFXFlag),a					; Clear SFX updating flag
	ret
; End of function zPauseMusic


; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
;zsub_64D
zResumeTrack:
	bit	playback_playing,(ix+zTrack.PlaybackControl)	; Is track playing?
	jr	Z,.dont						; Branch if not
	bit	playback_override,(ix+zTrack.PlaybackControl)	; Is SFX overriding track?
	jr	NZ,.dont					; Branch if not
	push	bc						; Save bc
	call	zSetVoice
	pop	bc						; Restore bc
.dont:
	ld	de,zTrack.len					; de = Track size
	add	ix,de						; Advance to next track
	djnz	zResumeTrack					; loop
	ret
; End of function zResumeTrack


; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||
;zsub_674
zCycleQueue:
	ld	hl,zQueueSlot1					; Get address of next sound
	rept (zQueueSlot3-zQueueSlot1),i
	ld	a,(hl)
	or	a
	if (i+1)<(zQueueSlot3-zQueueSlot1)
	jr	NZ,.queue
	inc	hl
	else
	ret	Z
	endif
	endr
.queue:
	ld	(hl),0						; Clear the slot
	ld	hl,zDataTable.musid_last			; get last music id
	ld	b,(hl)
	cp	b
	jp	C,zPlayMusic					; if below musend, play music

	inc	hl						; get first sound id
	ld	b,(hl)
	cp	b
	ret	C						; if between musend and sfxstart, exit

	inc	hl						; get last sound id
	ld	b,(hl)
	cp	b
	jp	C,zPlaySound					; if below sfxend, play sfx

	sub	CmdID__First
	ret	C						; if between sfxend and cmdstart, exit

	ld	hl,zCommandIndex
	ld	c,a
	ld	b,0
	add	hl,bc
	add	hl,bc
	ld	b,(hl)
	inc	hl
	ld	h,(hl)
	ld	l,b
	jp	(hl)
; ---------------------------------------------------------------------------
cmdinclude macro pointer,id
	dw pointer
	valfor68k id,rwaaauh
rwaaauh	defl rwaaauh+1
	endm
rwaaauh	defl 100h-((zCommandIndexEnd-zCommandIndex)/2)
zCommandIndex:
	valfor68k  CmdID__First,rwaaauh
	cmdinclude zPlaySegaChant,	cmdid_Sega
	cmdinclude zStopSoundEffects,	cmdid_StopSFX
	cmdinclude zFadeOutMusic,	cmdid_FadeOut
	cmdinclude zSpeedUpMusic,	cmdid_SpeedUp
	cmdinclude zSlowDownMusic,	cmdid_SlowDown
	cmdinclude zStopSoundAndMusic,	cmdid_Stop
	valfor68k  CmdID__End,rwaaauh
zCommandIndexEnd:
; ---------------------------------------------------------------------------
; zloc_73D:
zPlayMusic:
	push	af						; Save bgm id in 'a'
	ld	b,a						; Check for the 1up jingle ID
	ld	a,(zDataTable.musid_1up)
	cp	b
	jr	NZ,.not1up
	ld	a,(zPlaying1upFlag)				; Check if 1-up sound is already playing
	or	a						; Test it
	jr	NZ,zBGMLoad					; If it is, then just reload it!  (I suppose a humorous restore-to-1up could happen otherwise... with no good results after that)

	ld	ix,zTracksStart					; Starting at beginning of all tracks...
	ld	de,zTrack.len					; Each track size
	ld	b,(zTracksEnd-zTracksStart)/zTrack.len		; All 10 (DAC, 6FM, 3PSG) tracks
.bgmloop:
	res	playback_override,(ix+zTrack.PlaybackControl)	; Clear "SFX is overriding" bit (no SFX are allowed!)
	add	ix,de						; Next track
	djnz	.bgmloop

	ld	ix,zTracksSFXStart				; 'ix' points to start of SFX track memory (10 prior tracks were DAC, 6 FM, 3 PSG)
	ld	b,(zTracksSFXEnd-zTracksSFXStart)/zTrack.len	; 6 SFX tracks total (3FM, 3PSG)
.sfxloop:
	res	playback_playing,(ix+zTrack.PlaybackControl)	; Clear "is playing" bit!  (No SFX allowed!)
	add	ix,de						; Next track
	djnz	.sfxloop
	; This performs a "massive" backup of all of the current track positions 
	; for restoration after 1-up BGM completes
	ld	de,zTracksSaveStart				; Backup memory address
	ld	hl,zAbsVar					; Starts from zAbsVar
	ld	bc,zTracksSaveEnd-zTracksSaveStart		; for this many bytes
	ldir							; Go!
	ld	a,80h
	ld	(zPlaying1upFlag),a				; Set 1-up song playing flag
	xor	a
	ld	(zSFXPriorityVal),a				; Clears SFX priority
	jr	zBGMLoad					; Now load 1-up BGM
.not1up:
	xor	a
	ld	(zPlaying1upFlag),a				; clear 1-up is playing flag (it isn't)
	ld	(zAbsVar.FadeInCounter),a			; clear fade-in frame count
	ld	(zAbsVar.FadeOutCounter),a			; clear fade-out frame count

;zloc_78E
zBGMLoad:
	call	zInitMusicPlayback
	ld	a,(zDataTable.musid_first)			; Get first music ID into 'e'
	ld	e,a
	pop	af						; Restore bgm id in 'a'
	sub	e						; Make it a zero-based entry ...
	ld	e,a						; Transform 'a' into 16-bit de
	ld	d,0
	ld	hl,(zDataTable.bgmplaylist)			; Get address of the zMasterPlaylist
	rept 5
	add	hl,de
	endr
	ld	a,(hl)						; Get "fixed" index
	add	a,a						; Adding a+a causes a possible overflow and a multiplication by 2
;	ld	c,a						; Save result for other commands in c
	ccf							; Invert carry flag from overflow
	sbc	a,a						; ...so that this sets a to FFh if bit 7 of original a was clear (allow PAL double-update), zero otherwise (do not allow PAL double-update)
	ld	(zAbsVar.IsPalFlag),a
	inc	hl

	ld	a,(hl)						; Get value at this location -> 'a'
	ld	(zAbsVar.TempoTurbo),a				; Store 'a' here (provides an alternate tempo or something for speed up mode)
	inc	hl

	ld	a,(hl)						; Get "fixed" index
	ld	(zAbsVar.MusicBankNumber),a			; Store this (use to enable alternate bank)
	call	zBankSwitch
	inc	hl

	ld	e,(hl)
	inc	hl
	ld	d,(hl)

	; Begin common track init code
	push	de
	pop	ix						; ix = de (BGM's starting address)

	ld	e,(ix+0)					; Get voice table pointer low byte -> 'e'
	ld	d,(ix+1)					; Get voice table pointer high byte -> 'd'
	ld	(.fminst),de					; (self-modifying code)

	ld	a,(ix+5)					; Get main tempo value
	ld	(zAbsVar.TempoMod),a				; Store it
	ld	b,a						; tempo -> 'b'
	ld	a,(zAbsVar.SpeedUpFlag)				; Get found speed shoe flag (preloaded before this)
	or	a						; test it
	ld	a,b						; Restore normal song tempo
	jr	Z,.nospeed					; if the speed shoe flag was zero, skip this step
	ld	a,(zAbsVar.TempoTurbo)				; Put the corresponding speed shoe tempo for song
.nospeed:
	ld	(zAbsVar.CurrentTempo),a			; Current tempo for TempoWait
	ld	(zAbsVar.TempoTimeout),a			; Tempo accumulator for TempoWait
	ld	a,5
	ld	(zPALUpdTick),a					; reset PAL update tick to 5 (update immediately)

	push	ix
	pop	hl						; hl = ix (BGM's starting address)
	ld	de,6
	add	hl,de						; +06h (to DAC pointer)
	ld	a,(ix+2)					; Get number of FM+DAC channels this BGM has
	or	a						; Test it
	jp	Z,.nofm						; If zero, then don't init any
	ld	b,a						; 'a' -> 'b' (num FM+DAC channels this song, for loop)
	push	iy						; Save 'iy'
	ld	iy,zTracksStart					; 'iy' points to start of track memory
	ld	c,(ix+4)					; Get tempo divider -> 'c'
.fmloop:
	ld	(iy+zTrack.PlaybackControl),1<<playback_playing|1<<playback_resting	; Set "track is playing" bit and "track at rest" bit
	ld	(iy+zTrack.TempoDivider),c			; Store timing divisor from header for this track
	ld	(iy+zTrack.StackPointer),zTrack.GoSubStack	; set "gosub" (coord flag F8h) stack init value (starts at end of this track's memory)
	ld	(iy+zTrack.DurationTimeout),1			; set current duration timeout to 1 (should expire next update, play first note, etc.)
	ld	(iy+zTrack.AMSFMSPan),0C0h			; default Panning / AMS / FMS settings (only stereo L/R enabled)
.fminst	equ $+1
	ld	de,0						; fm voice table address (self-modified code)
	ld	(iy+zTrack.VoicePtrLow),e
	ld	(iy+zTrack.VoicePtrHigh),d
	push	bc						; saving number of channels and tempo divider ('bc' gets needlessly damaged by 'ldi' instructions coming up)
	ld	a,iyl						; current track pointer low byte -> 'a'
	add	a,zTrack.DataPointerLow
	ld	e,a
	adc	a,iyh
	sub	e
	ld	d,a						; de = iy + 3 ('de' is pointing to track offset address)
	ld	bc,4
	ldir							; while (bc-- > 0) *de++ = *hl++; (copy track address, default key offset, default volume)
	ld	de,zTrack.len					; size of all tracks -> 'de'
	add	iy,de						; offset to next track!
	pop	bc						; restore 'bc' (number of channels and tempo divider)
	djnz	.fmloop						; loop for all tracks we're init'ing...
	; End of FM+DAC track init loop

	pop	iy						; restore 'iy'
	ld	a,(ix+2)					; 'ix' still points to start of BGM; get number of FM+DAC -> 'a'
	cp	7						; Does it equal 7?  (6 FM channels)
	jr	NZ,.fm6mute					; If not, skip this next part
	xor	a						; Clear 'a'
	jr	.leavefm6alone
.fm6mute:
	; Silence FM Channel 6 specifically if it's not in use
	; Set all TL values to silence!
	ld	a,42h						; Starting at FM Channel 6 Operator 1 Total Level register
	ld	c,0FFh						; Silence value
	ld	b,4						; Write to all four FM Channel 6 operators
.fm6loop:
	rst	zWriteFMII
	add	a,4						; Next operator
	djnz	.fm6loop

	ld	a,0B6h						; Set Panning / AMS / FMS
	ld	c,0C0h						; default Panning / AMS / FMS settings (only stereo L/R enabled)
	rst	zWriteFMII					; Set it!
	ld	a,80h						; FM Channel 6 is NOT in use (will enable DAC)
.leavefm6alone:
	ld	c,a
	ld	(zAbsVar.DACEnabled),a				; Note whether FM Channel 6 is in use (enables DAC if not)
	ld	a,2Bh						; Set DAC Enable appropriately
	rst	zWriteFMI					; Set it!
.nofm:
	; End of DAC/FM init, begin PSG init

	ld	a,(ix+3)					; Get number of PSG tracks
	or	a						; Test it
	jp	Z,.nopsg					; If zero, skip this part!
	ld	b,a						; 'a' -> 'b' (num PSG tracks this song, for loop)
	push	iy						; Save 'iy'
	ld	iy,zSongPSG1					; 'iy' points to start of PSG track memory (7 prior tracks were DAC and 6 FM)
	ld	c,(ix+4)					; Get tempo divider -> 'c'
.psgloop:
	ld	(iy+zTrack.PlaybackControl),1<<playback_playing|1<<playback_resting	; Set "track is playing" bit and "track at rest" bit
	ld	(iy+zTrack.TempoDivider),c			; Store timing divisor from header for this track
	ld	(iy+zTrack.StackPointer),zTrack.GoSubStack	; "gosub" stack init value
	ld	(iy+zTrack.DurationTimeout),1			; set current duration timeout to 1 (should expire next update, play first note, etc.)
	push	bc						; saving number of channels and tempo divider ('bc' gets needlessly damaged by 'ldi' instructions coming up)
	ld	a,iyl						; current track pointer low byte -> 'a'
	add	a,zTrack.DataPointerLow
	ld	e,a
	adc	a,iyh
	sub	e
	ld	d,a						; de = iy + 3 ('de' is pointing to track offset address)
	ld	bc,6
	ldir							; while (bc-- > 0) *de++ = *hl++; (copy track address, default key offset, default volume, modctrl, volenv)
	ld	de,zTrack.len					; size of all tracks -> 'de'
	add	iy,de						; offset to next track!
	pop	bc						; restore 'bc' (number of channels and tempo divider)
	djnz	.psgloop					; loop for all tracks we're init'ing...
	pop	iy						; restore 'iy'
.nopsg:
	; End of PSG tracks init, begin SFX tracks init

	ld	ix,zTracksSFXStart				; 'ix' points to start of SFX track memory (10 prior tracks were DAC, 6 FM, 3 PSG)
	ld	b,(zTracksSFXEnd-zTracksSFXStart)/zTrack.len	; 6 SFX tracks total (3FM, 3PSG)
	ld	de,zTrack.len					; size between tracks
.sfxloop:
	bit	playback_playing,(ix+zTrack.PlaybackControl)	; Is this track currently playing?
	jr	Z,.nosfx					; If not, branch
	ld	a,(ix+zTrack.VoiceControl)			; Get "voice control" byte...
	or	a						; Test it
	jp	M,.sfxpsg					; If this is a PSG track, jump to '+'
	sub	2						; Otherwise, subtract 2...
	add	a,a						; ... multiply by 2 (preparing to index starting from FM 3 only)
	jr	.sfxfmcont
.sfxpsg:
	rra
	rra
	rra
	rra
	and	0Fh						; for PSG, just shift it down by 4 and we have its index!
.sfxfmcont:
	call	zGetMusicTrackOffset
	set	playback_override,(hl)				; Set the "SFX override" bit
.nosfx:
	add	ix,de						; Next track..
	djnz	.sfxloop					; Loop for all tracks
	; End of SFX tracks init...

	ld	ix,zSongFM1					; 'ix' points to first FM music track
	ld	b,(zSongPSG1-zSongFM1)/zTrack.len		; For all 6 of those...
	; zFMNoteOff isn't enough to silence the entire channel:
	; For added measure, we set Total Level and Release Rate, too.
.fmoff:
	call	zFMSilenceChannel				; If not, branch
	add	ix,de						; Next track
	djnz	.fmoff

	ld	b,(zTracksEnd-zSongPSG1)/zTrack.len		; For all 3 PSG tracks...
.psgoff:
	call	zPSGNoteOff					; Send Note Off
	add	ix,de						; Next track
	djnz	.psgoff

	ret
; ---------------------------------------------------------------------------
; FM channel assignment bits
;zbyte_916
zFMDACInitBytes:	db    6,   0,   1,   2,   4,   5,   6	; first byte is for DAC; then notice the 0, 1, 2 then 4, 5, 6; this is the gap between parts I and II for YM2612 port writes

; Default values for PSG tracks
;zbyte_91D
zPSGInitBytes:	db  80h,0A0h,0C0h				; Specifically, these configure writes to the PSG port for each channel

; zloc_920:
zPlaySound_KillSFXPrio:
	xor	a
	ld	(zSFXPriorityVal),a				; Reset SFX priority
	ret
zPlaySound:
	ld	c,a						; Store sound index -> 'c'
	ld	a,(zPlaying1upFlag)				; Get "is 1-up playing" flag...
	or	(ix+zVar.FadeInFlag)				; Or it with fading in flag
	jr	NZ,zPlaySound_KillSFXPrio			; If either is set, SFX cannot be played!!
	call	zBankSwitchToSFX				; Switch to SFX banks
; zero-index the sfx id
	ld	a,(zDataTable.sfxid_first)			; Get first sfx id into 'e'
	ld	e,a
	ld	a,c						; Retrieve sfx id in 'c' and put it in 'a'
	sub	e						; Make it a zero-based index
; handle SFX priority
	ld	hl,(zDataTable.sfxloc)
	ld	e,a						; Put zero-index sfx id into 'e'
	ld	d,0
	rept 3
	add	hl,de
	endr
	ld	a,(zSFXPriorityVal)
	ld	d,a
	ld	a,(hl)						; Get SFX priority
	cp	d						; Is the new SFX of a higher priority?
	ret	C						; Exit if not
	or	a						; Don't save the new id if it's 80h or above
	jp	M,.queue
	ld	(zSFXPriorityVal),a
.queue:
	ld	a,e						; Restore zero-index sfx id
; Begin the whole process of playing a sound effect
	inc	hl
	ld	a,(hl)
	inc	hl
	ld	h,(hl)
	ld	l,a						; now hl points to a sound's data

	ld	e,(hl)
	inc	hl
	ld	d,(hl)						; 'de' points to custom voice table (if any; otherwise is 0000h)
	inc	hl
	ld	(.fminst),de					; store into the instruction after .fminst (self-modifying code)

	ld	c,(hl)						; Timing divisor -> 'c'
	inc	hl
	ld	b,(hl)						; Total channels used -> 'b'
	inc	hl
.loop:
	push	bc						; backup channel usage

	ld	a,(hl)						; Track sound def -> 'a' (if bit 7 is set it's PSG, otherwise it's FM)
	or	a						; test it
	jp	M,.psgsound					; if bit 7 (80h) set (meaning PSG track), skip next part...
	sub	2						; Subtract 2 from this value
	add	a,a						; Multiply it by 2
	jr	.fmsound					; This is an FM sound track...
.psgsound:
	cp	0C0h						; Is this PSG3?
	jr	NZ,.psg3					; If not, skip this part
	push	af
	or	1Fh						; Set silence on PSG!
	ld	(zPSG),a
	xor	20h
	ld	(zPSG),a
	pop	af
.psg3:
	rra
	rra
	rra
	rra
	and	0Fh						; for PSG, just shift it down by 4 and we have its index!

.fmsound:
	push	hl						; save current position within sound (offset 04h)

	ld	e,a						; save for SFX track offset
	call	zGetMusicTrackOffset
	set	playback_override,(hl)				; Set "SFX is overriding this track!" bit for the corresponding BGM
	ld	a,e
	add	a,zSFXTrackOffs-zMusicTrackOffs
	call	zGetMusicTrackOffset
	ld	e,l						; de = hl = start of sfx channel ram
	ld	d,h
	push	de						; ix = de = hl = start of channel ram
	pop	ix

	; Now we're going to clear this SFX track...
	ld	(hl),0						; store 00h on first byte of track
	inc	de						; next byte...
	ld	bc,zTrack.len-1					; For all bytes in the track, minus 1 (since we're copying 00h from first byte)
	ldir							; Clear track memory!

	; Now let's actually set it up
	pop	hl						; Get 'hl' back from way before (offset of sound in ROM + 04h)
	ld	(ix+zTrack.PlaybackControl),1<<playback_playing
	ld	a,(hl)
	inc	hl
	ld	(ix+zTrack.VoiceControl),a
	bit	7,a						; check if the channel is an FM track
	jr	NZ,.notfm
.fminst	equ $+1
	ld	de,0						; fm voice table address (self-modified code)
	ld	(ix+zTrack.VoicePtrLow),e
	ld	(ix+zTrack.VoicePtrHigh),d
	ld	(ix+zTrack.AMSFMSPan),0C0h			; Default panning / AMS / FMS settings (just L/R Stereo enabled)
.notfm:
	push	ix						; de = start of channel ram, again
	pop	de
	ld	a,e
	add	a,zTrack.DataPointerLow
	ld	e,a
	adc	a,d
	sub	e
	ld	d,a						; de += 1 (skip timing divisor; already set)
	ld	bc,4
	ldir							; while (bc-- > 0) *de++ = *hl++; (copy track address, default key offset, volume)

	pop	bc						; restore channel count and divisor
	ld	(ix+zTrack.TempoDivider),c			; Set divisor
	ld	(ix+zTrack.DurationTimeout),1			; current duration timeout to 1 (will expire immediately and thus update)
	ld	(ix+zTrack.StackPointer),zTrack.GoSubStack	; Reset track "gosub" stack
	djnz	.loop
;	dec	b
;	jp	NZ,.loop
	ret
; End of function zPlaySoundByIndex


; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||

; zsub_A3C:
zStopSoundEffects:
	xor	a
	ld	(zSFXPriorityVal),a				; Reset SFX priority
	ld	ix,zTracksSFXStart				; 'ix' points to start of SFX track memory (10 prior tracks were DAC, 6 FM, 3 PSG)
	ld	b,(zTracksSFXEnd-zTracksSFXStart)/zTrack.len	; All 6 SFX tracks...
.loop:
	push	bc						; Save 'bc'
	bit	playback_playing,(ix+zTrack.PlaybackControl)	; Check if this track was playing
	jr	Z,.fmcont					; If not 
	res	playback_playing,(ix+zTrack.PlaybackControl)	; You're not playing anymore!
	res	playback_noattack,(ix+zTrack.PlaybackControl)	; Not not attacking, either
	ld	a,(ix+zTrack.VoiceControl)			; Get "voice control" byte
	or	a						; Test it
	jp	M,.psg						; If 80h set (PSG Track) jump to .psg
.fm:
	push	af
	call	zFMNoteOff					; FM Key off
	pop	af
	push	ix
	call	zGetMusicTrackOffset
	push	hl
	pop	ix
	bit	playback_override,(ix+zTrack.PlaybackControl)	; Was this music track is overridden by an SFX track?
	jr	Z,.sfxoverride					; If not, do nothing
	res	playback_override,(ix+zTrack.PlaybackControl)	; Otherwise, tell it is is no longer!
	set	playback_resting,(ix+zTrack.PlaybackControl)	; Set track to rest
	call	zSetVoice					; Reset FM voice
.sfxoverride:
	pop	ix
	jp	.fmcont						; jump down to loop
.psg:
	push	af
	call	zPSGNoteOff					; PSG Note off
	pop	af
	push	ix
	rra
	rra
	rra
	rra
	and	0Fh						; 'a' is now 08, 0A, 0C, or 0E
	call	zGetMusicTrackOffset
	push	hl
	pop	ix
	res	playback_override,(ix+zTrack.PlaybackControl)	; tell this track it is is no longer overridden by SFX!
	set	playback_resting,(ix+zTrack.PlaybackControl)	; Set track to rest
	ld	a,(ix+zTrack.VoiceControl)			; Get voice control
	cp	0E0h						; Is this a PSG 3 noise (not tone) track?
	jr	NZ,.psg4					; If it isn't, don't do next part (non-PSG Noise doesn't restore)
	ld	a,(ix+zTrack.PSGNoise)				; Get PSG noise setting
	ld	(zPSG),a					; Write it to PSG
.psg4:
	pop	ix
.fmcont:
	ld	de,zTrack.len
	add	ix,de						; Got to next track
	pop	bc						; Restore 'bc'
	djnz	.loop					; Loop around...
	ret
; End of function zStopSoundEffects

; ---------------------------------------------------------------------------
; zloc_ABF:
zFadeOutMusic:
	ld	a,3
	ld	(zAbsVar.FadeOutDelay),a			; Set delay ticker to 3
	ld	a,28h
	ld	(zAbsVar.FadeOutCounter),a			; Set total frames to decrease volume over
	xor	a
	ld	(zAbsVar.SpeedUpFlag),a				; No speed shoe tempo?
;	xor	a
	ld	(zSongDAC.PlaybackControl),a			; Stop DAC track (can't fade it)
	ret

; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||


;zsub_AD1
zUpdateFadeout:
	ld	a,(zAbsVar.FadeOutDelay)			; Get current tick count before next volume decrease
	or	a
	jr	Z,.delay					; If not yet zero...
	dec	(ix+zVar.FadeOutDelay)				; Just decrement it
	ret
.delay:
	dec	(ix+zVar.FadeOutCounter)			; Otherwise, decrement fadeout!
	jp	Z,zClearTrackPlaybackMem			; If it hits zero, clear everything!
	ld	(ix+zVar.FadeOutDelay),3			; Otherwise, reload tick count with 3

	push	ix

	ld	ix,zSongFM1					; 'ix' points to first FM music track
	ld	b,(zSongPSG1-zSongFM1)/zTrack.len		; 6 FM tracks to follow...
.fmloop:
	bit	playback_playing,(ix+zTrack.PlaybackControl)	; Is this track playing?
	jr	Z,.fmnop					; If not, do nothing
	inc	(ix+zTrack.Volume)				; increment channel volume (remember -- higher is quieter!)
	jp	P,.fmmaxvol					; don't let it overflow
	res	playback_playing,(ix+zTrack.PlaybackControl)	; otherwise, stop playing this track
	jr	.fmnop						; just loop
.fmmaxvol:
	push	bc
	ld	b,(ix+zTrack.Volume)				; Channel volume -> 'b'
	ld	a,(ix+zTrack.VolEnvID)
	or	a						; Is this track using volume envelope 0 (no envelope)?
	call	Z,zUpdateVolume					; If so, update volume (this code is only run on envelope 1+, so we need to do it here for envelope 0)
	pop	bc
.fmnop:
	ld	de,zTrack.len	
	add	ix,de						; Next track
	djnz	.fmloop						; Keep going for all FM tracks...


	ld	b,(zTracksEnd-zSongPSG1)/zTrack.len		; 3 PSG tracks to follow...
.psgloop:
	bit	playback_playing,(ix+zTrack.PlaybackControl)	; Is this track playing?
	jr	Z,.psgnop					; If not, do nothing
	inc	(ix+zTrack.Volume)				; increment channel volume (remember -- higher is quieter!)
	ld	a,10h
	cp	(ix+zTrack.Volume)				; don't let volume go over 0Fh on PSG tracks!
	jp	NC,.psgmaxvol
	res	playback_playing,(ix+zTrack.PlaybackControl)	; Otherwise, stop playing this track
	jr	.psgnop
.psgmaxvol:
	push	bc
	ld	b,(ix+zTrack.Volume)				; Channel volume -> 'b'
	ld	a,(ix+zTrack.VolEnvID)
	or	a						; Is this track using volume envelope 0 (no envelope)?
	call	Z,zUpdateVolume					; If so, update volume (this code is only run on envelope 1+, so we need to do it here for envelope 0)
	pop	bc
.psgnop:
	ld	de,zTrack.len
	add	ix,de						; Next track
	djnz	.psgloop					; Keep going for all PSG tracks...

	pop	ix
	ret
; End of function zUpdateFadeout


; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||


;zsub_B36
zFMSilenceAll:
	ld	a,28h						; Start at FM KEY ON/OFF register
	ld	b,3						; Three key on/off per part
.loop1:
	ld	c,b						; Current key off -> 'c'
	dec	c						; c--
	rst	zWriteFMI					; Write key off for part I 
	set	2,c						; Set part II select
	rst	zWriteFMI					; Write key off for part II
	djnz	.loop1	

	ld	a,30h						; Starting at FM register 30h...
	ld	c,0FFh						; Write dummy kill-all values
	ld	b,60h						; ... up to register 90h
.loop2:
	rst	zWriteFMI					; ... on part I
	rst	zWriteFMII					; ... and part II
	inc	a						; Next register!
	djnz	.loop2

	ret
; ---------------------------------------------------------------------------
; zloc_B4E:
zStopSoundAndMusic:
zClearTrackPlaybackMem:
	; This totally wipes out the track memory and resets playback hardware
	ld	a,2Bh						; DAC Enable register
	ld	c,80h						; Enable DAC
	rst	zWriteFMI					; Write it!
	ld	a,c						; 80h -> 'a'
	ld	(zAbsVar.DACEnabled),a				; Store that to DAC Enabled byte
	ld	a,27h						; Channel 3 special settings
	ld	c,0						; All clear
	rst	zWriteFMI					; Write it!
	; This performs a full clear across all track/playback memory
	ld	hl,zClearRange
	ld	de,zClearRange+1
	ld	(hl),0						; Starting byte is 00h
	ld	bc,(zTracksSFXEnd-zClearRange)-1		; For 695 bytes...
	ldir							; 695 bytes of clearing!
	call	zFMSilenceAll					; Silence FM
	jp	zPSGSilenceAll					; Silence PSG
; End of function zClearTrackPlaybackMem


; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||


;zsub_B78
zInitMusicPlayback:
	; This function saves some of the queue/flag items and
	; otherwise resets all music-related playback memory and
	; silences the hardware.  Used prior to playing a new song.
	; Very similar to zClearTrackPlaybackMem except that it is
	; specific to the music tracks...

	; Save some queues/flags:
	ld	ix,zAbsVar
	ld	b,(ix+zVar.FadeInCounter)
	ld	c,(ix+zVar.SpeedUpFlag)
	push	bc
	; The following clears all playback memory and non-SFX tracks
	ld	hl,zMusClearRange
	ld	de,zMusClearRange+1
	ld	(hl),0
	ld	bc,(zTracksEnd-zMusClearRange)-1
	ldir
	; Restore those queue/flags:
	pop	bc
	ld	(ix+zVar.SpeedUpFlag),c
	ld	(ix+zVar.FadeInCounter),b

	; If a music file's header doesn't define each and every channel, they
	; won't be silenced by zloc_8FB, because their tracks aren't properly
	; initialised. This can cause hanging notes. So, we'll set them up
	; properly here.
	ld	ix,zTracksStart					; Start at the first music track...
	ld	b,(zTracksEnd-zTracksStart)/zTrack.len		; ...and continue to the last
	ld	de,zTrack.len
	ld	hl,zFMDACInitBytes				; This continues into zPSGInitBytes
.loop:
	ld	a,(hl)
	inc	hl
	ld	(ix+zTrack.VoiceControl),a			; Set channel type while we're at it, so subroutines understand what the track is
	add	ix,de						; Next track
	djnz	.loop						; loop for all channels

	ret
; End of function zInitMusicPlayback

; ---------------------------------------------------------------------------
; zloc_BBE:
; increases the tempo of the music
zSpeedUpMusic:
	ld	b,80h
	ld	a,(zPlaying1upFlag)
	or	a
	ld	a,(zAbsVar.TempoTurbo)
	jr	Z,zSetTempo
	jr	zSetTempo_1up

; ===========================================================================
; zloc_BCB:
; returns the music tempo to normal
zSlowDownMusic:
	ld	b,0
	ld	a,(zPlaying1upFlag)
	or	a
	ld	a,(zAbsVar.TempoMod)
	jr	Z,zSetTempo
	jr	zSetTempo_1up

; ===========================================================================
; helper routines for changing the tempo
zSetTempo:
	ld	(zAbsVar.CurrentTempo),a		; Store new tempo value 
	ld	a,b
	ld	(zAbsVar.SpeedUpFlag),a
	ret
; ---------------------------------------------------------------------------
;zloc_BE0
zSetTempo_1up:
	ld	(zSaveVar.CurrentTempo),a	; Store new tempo value 
	ld	a,b
	ld	(zSaveVar.SpeedUpFlag),a
	ret

; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||


;zsub_BE8
zUpdateFadeIn:
	ld	a,(zAbsVar.FadeInDelay)				; Get current tick count before next volume increase
	or	a
	jr	Z,.delay					; If not yet zero...
	dec	(ix+zVar.FadeInDelay)				; Just decrement it
	ret
.delay:
	ld	a,(zAbsVar.FadeInCounter)			; Get current fade out frame count
	or	a
	jr	NZ,.counter					; If fadeout hasn't reached zero yet, skip this
	ld	a,(zSongDAC.PlaybackControl)			; Get DAC's playback control byte
	and	~(1<<playback_override)				; Clear "SFX is overriding" bit
	ld	(zSongDAC.PlaybackControl),a			; Set that
	xor	a
	ld	(zAbsVar.FadeInFlag),a				; Done fading-in, SFX can play now 
	ret
.counter:
	dec	(ix+zVar.FadeInCounter)				; Otherwise, we decrement fadein!
	ld	(ix+zVar.FadeInDelay),2				; Otherwise, reload tick count with 2 (little faster than fadeout)
	push	ix

	ld	ix,zSongFM1					; 'ix' points to first FM music track
	ld	b,(zSongPSG1-zSongFM1)/zTrack.len		; 6 FM tracks to follow...
.fmloop:
	bit	playback_playing,(ix+zTrack.PlaybackControl)	; Is this track playing?
	jr	Z,.fmnop					; If not, do nothing
	dec	(ix+zTrack.Volume)				; decrement channel volume (remember -- lower is louder!)
	push	bc
	ld	b,(ix+zTrack.Volume)				; Channel volume -> 'b'
	ld	a,(ix+zTrack.VolEnvID)
	or	a						; Is this track using volume envelope 0 (no envelope)?
	call	Z,zUpdateVolume					; If so, update volume (this code is only run on envelope 1+, so we need to do it here for envelope 0)
	pop	bc
.fmnop
	ld	de,zTrack.len
	add	ix,de						; Next track
	djnz	.fmloop						; Keep going for all FM tracks...

	ld	b,(zTracksEnd-zSongPSG1)/zTrack.len		; 3 PSG tracks to follow...
.psgloop:
	bit	playback_playing,(ix+zTrack.PlaybackControl)	; Is this track playing?
	jr	Z,.psgnop					; If not, do nothing
	dec	(ix+zTrack.Volume)				; decrement channel volume (remember -- lower is louder!)
	push	bc
	ld	b,(ix+zTrack.Volume)				; Channel volume -> 'b'
	ld	a,(ix+zTrack.VolEnvID)
	or	a						; Is this track using volume envelope 0 (no envelope)?
	call	Z,zUpdateVolume					; If so, update volume (this code is only run on envelope 1+, so we need to do it here for envelope 0)
	pop	bc
.psgnop:
	ld	de,zTrack.len
	add	ix,de						; Next track
	djnz	.psgloop					; Keep going for all PSG tracks...

	pop	ix
	ret
; End of function zUpdateFadeIn


; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||


;zsub_C46
zFMNoteOn:
	ld	a,(ix+zTrack.PlaybackControl)			; Get playback control byte
	and	1<<playback_resting|1<<playback_override
	ret	NZ						; If either bit 1 ("track in rest") and 2 ("SFX overriding this track"), quit!
	ld	a,(ix+zTrack.VoiceControl)			; Get "voice control" byte
	or	0F0h						; Turn on ALL operators
	ld	c,a						; Set as data to write to FM
	ld	a,28h						; Write to KEY ON/OFF port (key ON in this case)
	rst	zWriteFMI					; do it!
	ret
; End of function zFMNoteOn


; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||

;zsub_C56
zFMSilenceChannel:
	bit	playback_override,(ix+zTrack.PlaybackControl)	; Is "SFX override" bit set?
	ret	NZ						; If so, quit!
	push	bc
	add	a,80h
	ld	bc,80h<<8|0FFh					; Set D1L to minimum and RR to maximum
	call	zFMOperatorWriteLoop
	ld	bc,40h<<8|7Fh					; Set total level to minimum envelope amplitude
	call	zFMOperatorWriteLoop
	pop	bc
;	jr	zFMNoteOff

zFMNoteOff:
	ld	a,(ix+zTrack.PlaybackControl)			; Load this track's playback control byte
	and	1<<playback_noattack|1<<playback_override	; Are bits 4 (no attack) or 2 (SFX overriding) set?
	ret	NZ						; If they are, return
	ld	a,28h						; Otherwise, send a KEY ON/OFF
	ld	c,(ix+zTrack.VoiceControl)			; Track's data for this key operation
	
	; Format of key on/off:
	; 4321 .ccc
	; Where 4321 are the bits for which operator,
	; and ccc is which channel (0-2 for channels 1-3, 4-6 for channels 4-6 WATCH BIT GAP)
	
	rst	zWriteFMI					; Write to part I (Note this particular register is ALWAYS sent to part I)
	ret

zFMOperatorWriteLoop:
	ld	a,(ix+zTrack.VoiceControl)			; Get voice control byte
	and	3						; Channels only!
	add	b
	ld	b,4						; Loop 4 times
.loop:	rst	zWriteFMIorII					; Write to part I or II, as appropriate
	add	a,4						; a += 4
	djnz	.loop						; Loop
	ret
; ---------------------------------------------------------------------------
zBankSwitchToSFX:
	ld	a,(zDataTable.sfxbank)
	jr	zBankSwitch

zBankSwitchToMusic:
	ld	a,(zAbsVar.MusicBankNumber)
	;jr	zBankSwitch

; a = bank
zBankSwitch:
	push	hl
	ld	hl,zBankRegister
	rept 8
	ld	(hl),a
	rrca
	endr
	ld	(hl),h
	pop	hl
	ret
; ---------------------------------------------------------------------------
zCoordFlag:
	sub	0E0h
	add	a			; table+(index*2)
	add	a,.tbl&$FF
	ld	e,a
	adc	a,.tbl>>8
	sub	e
	ld	d,a
	ld	a,(de)			; get pointer from table into bc
	ld	c,a
	inc	de
	ld	a,(de)
	ld	b,a
	ld	a,(hl)			; prepare first flag input into a
	inc	hl
	push	bc			; makeshift jp (bc)
	ret
.tbl:	dw	cfPanningAMSFMS		; E0
	dw	cfDetune		; E1
	dw	cfSetCommunication	; E2
	dw	cfJumpReturn		; E3
	dw	cfSpindashRev		; E4
	dw	cfSetTempoDivider	; E5
	dw	cfChangeFMVolume	; E6
	dw	cfPreventAttack		; E7
	dw	cfNoteFill		; E8
	dw	cfChangeTransposition	; E9
	dw	cfSetTempo		; EA
	dw	cfSetTempoMod		; EB
	dw	cfChangePSGVolume	; EC
	dw	cfClearPush		; ED
	dw	cfStopSpecialFM4	; EE
	dw	cfSetVoice		; EF
	dw	cfModulation		; F0
	dw	cfEnableModulation	; F1
	dw	cfStopTrack		; F2
	dw	cfSetPSGNoise		; F3
	dw	cfDisableModulation	; F4
	dw	cfSetPSGTone		; F5
	dw	cfJumpTo		; F6
	dw	cfRepeatAtPos		; F7
	dw	cfJumpToGosub		; F8
	dw	cfWriteFMI		; F9
; ---------------------------------------------------------------------------

; (via Saxman's doc): panning, AMS, FMS  
;zloc_CFC
cfPanningAMSFMS:
;Panning, AMS, FMS
;* xx - Value (reg a)
;      o Bit 7 - Left channel status
;      o Bit 6 - Right channel Status
;      o Bit 5-3 - AMS
;      o Bit 2 - 0
;      o Bit 1-0 - FMS 

	; Subject to verification, but even though you COULD set
	; AMS/FMS values, it does not appear that's what they intended
	; here; instead it appears they only meant for panning control.
	; I say this because it retains prior AMS/FMS settings ("and 37h")
		
	bit	7,(ix+zTrack.VoiceControl)			; a PSG track
	ret	M						; If so, quit!
	ld	c,a						; input val 'a' -> c
	ld	a,(ix+zTrack.AMSFMSPan)				; old PAF value
	and	37h						; retains bits 0-2, 3-4?
	or	c						; OR'd with new settings
	ld	(ix+zTrack.AMSFMSPan),a				; new PAF value
	bit	playback_override,(ix+zTrack.PlaybackControl)	; If "SFX overriding" bit set...
	ret	NZ						; return
	ld	c,a						; a -> c (YM2612 data write)
	ld	a,(ix+zTrack.VoiceControl)			; Get voice control byte
	and	3						; Channels only!
	add	a,0B4h						; Add register B4, stereo output control and LFO sensitivity 
	rst	zWriteFMIorII					; depends on bit 2 of (ix+zTrack.VoiceControl)
	ret
; ---------------------------------------------------------------------------

; (via Saxman's doc): Alter note values by xx 
; More or less a pitch bend; this is applied to the frequency as a signed value
;zloc_D1A cfAlterNotesUNK cfAlterNotes:
cfDetune:
	ld	(ix+zTrack.Detune),a				; set new detune value
	ret
; ---------------------------------------------------------------------------

; Set otherwise unused communication byte to parameter
; Used for triggering a boss' attacks in Ristar
;zloc_D1E cfUnknown1
cfSetCommunication:
	ld	(zCommunication),a
	ret
; ---------------------------------------------------------------------------

; Return (Sonic 1 & 2)
;zloc_D22
cfJumpReturn:
	ld	c,(ix+zTrack.StackPointer)			; Get current stack offset -> 'c'
	ld	b,0						; b = 0
	push	ix
	pop	hl						; hl = ix
	add	hl,bc						; hl += bc (latest item on "gosub" stack)
	ld	a,(hl)			
	inc	hl
	ld	h,(hl)
	ld	l,a						; hl = address from "gosub" stack
	inc	c
	inc	c
	ld	(ix+zTrack.StackPointer),c			; add 2 to "gosub" stack offset (pop)
	ret
; ---------------------------------------------------------------------------

; Change tempo divider to xx
;zloc_DB7
cfSetTempoDivider:
	ld	(ix+zTrack.TempoDivider),a			; Set tempo divider on this track only
	ret
; ---------------------------------------------------------------------------

; (via Saxman's doc): Change channel volume BY xx; xx is signed 
;zloc_DBB cfSetVolume
cfChangeFMVolume:
	add	a,(ix+zTrack.Volume)				; Add to current volume
	ld	(ix+zTrack.Volume),a				; Update volume
	ret
; ---------------------------------------------------------------------------

; (via Saxman's doc): prevent next note from attacking 
;zloc_DC4
cfPreventAttack:
	set	playback_noattack,(ix+zTrack.PlaybackControl)	; Set bit 4 (10h) on playback control; do not attack next note
	dec	hl						; Takes no argument, so just put it back
	ret
; ---------------------------------------------------------------------------

; (via Saxman's doc): set note fill amount to xx 
;zloc_DCA
cfNoteFill:
	ld	(ix+zTrack.NoteFillTimeout),a			; Note fill value (modifiable)
	ld	(ix+zTrack.NoteFillMaster),a			; Note fill value (master copy, rewrites +0Fh when necessary)
	ret
; ---------------------------------------------------------------------------

; (via Saxman's doc): add xx to channel key 
;zloc_DD1 cfAddKey:
cfChangeTransposition:
	add	a,(ix+zTrack.Transpose)				; Add to current transpose value
	ld	(ix+zTrack.Transpose),a				; Store updated transpose value
	ret
; ---------------------------------------------------------------------------

; (via Saxman's doc): set music tempo to xx 
;zloc_DD8
cfSetTempo:
	ld	(zAbsVar.CurrentTempo),a			; Set tempo
	ret
; ---------------------------------------------------------------------------

; (via Saxman's doc): Change Tempo Modifier to xx for ALL channels 
;zloc_DDC
cfSetTempoMod:
	push	ix						; Save 'ix'

	ld	ix,zTracksStart					; Start at beginning of track memory
	ld	de,zTrack.len					; Track size
	ld	b,(zTracksEnd-zTracksStart)/zTrack.len		; All 10 tracks
.loop:	ld	(ix+zTrack.TempoDivider),a			; Sets the timing divisor for ALL tracks; this can result in total half-speed, quarter-speed, etc.
	add	ix,de
	djnz	.loop

	pop	ix						; Restore 'ix'
	ret
; ---------------------------------------------------------------------------

; (via Saxman's doc): Change channel volume TO xx; xx is signed (Incorrect, see below)
; However, I've noticed this is incorrect; first of all, you'll notice
; it's still doing an addition, not a forced set.  Furthermore, it's
; not actually altering the FM yet; basically, until the next voice
; switch, this volume change will not come into effect.  Maybe a better
; description of it is "change volume by xx when voice changes", which
; makes sense given some voices are quieter/louder than others, and a
; volume change at voice may be necessary... or my guess anyway.

; Alternatively, just think of it as a volume setting optimized for PSG :P
;zloc_DF9 cfChangeVolume
cfChangePSGVolume:
	add	a,(ix+zTrack.Volume)				; Add to channel volume
	ld	(ix+zTrack.Volume),a				; Store updated volume
	ret
; ---------------------------------------------------------------------------

; Unused command EDh
; This used to be Sonic 1's cfClearPush. The whole Push SFX feature
; was retained when the driver was ported to Z80, but eventually removed in Beta 5.
; This broken code is all that's left of it.
;zlocret_E00 cfUnused cfUnused1
cfClearPush:
; ---------------------------------------------------------------------------

; Unused command EEh
; This used to be Sonic 1's cfStopSpecialFM4. But the Special SFX function hasn't been ported...
;zloc_E01 cfVoiceUNK cfUnused2
cfStopSpecialFM4:
	dec	hl						; Put back byte; does nothing
	ret
; ---------------------------------------------------------------------------

; (via Saxman's doc): set voice selection to xx 
;zloc_E03
cfSetVoice:
	ld	(ix+zTrack.VoiceID),a				; Set current voice
	bit	playback_override,(ix+zTrack.PlaybackControl)	; If "SFX is overriding this track" bit set...
	ret	NZ						; .. return!
	push	hl						; Save 'hl'
	call	zSetVoice					; Set the new voice!
	pop	hl						; Restore 'hl'
	ret

; ||||||||||||||| S U B	R O U T	I N E |||||||||||||||||||||||||||||||||||||||


;zsub_E12
zSetVoice:
	ld	a,(ix+zTrack.VoiceID)				; Get voice this track was using
	ld	l,(ix+zTrack.VoicePtrLow)			; get low byte of custom voice table
	ld	h,(ix+zTrack.VoicePtrHigh)			; get high byte of custom voice table

	; The following is a crazy block designed to 'multiply' our target voice value by 25...
	; Where a single voice is 25 bytes long
	push	hl						; push 'hl' for the end of the following block...
	ld	c,a						; a -> c
	ld	b,0						; b = 0 (so only low byte of 'bc' is set, basically voice to set)
	add	a,a						; a *= 2 (indexing something...)
	ld	l,a						; low byte of 'hl' set to 'a'
	ld	h,b						; high byte = 0
	add	hl,hl						; hl *= 2
	add	hl,hl						; hl *= 2 (total hl * 4!!)
	ld	e,l	
	ld	d,h						; de = hl
	add	hl,hl						; hl *= 2
	add	hl,de						; hl += de
	add	hl,bc						; hl += bc (waaah!)
	pop	de						; old 'hl' value -> 'de'
	add	hl,de						; hl += de (Adds address from the very beginning)
	; End crazy multiply-by-25 block

	; Sets up a value for future Total Level setting...
	ld	a,(hl)						; Get feedback/algorithm -> a
	inc	hl						; next byte of voice...
	ld	c,a						; a -> c (will be data to YM2612)
	ld	a,(ix+zTrack.VoiceControl)			; Get "voice control" byte
	and	3						; only keep bits 0-2 (bit 2 specifies which chip to write to)
	add	a,0B0h						; add to get appropriate feedback/algorithm register
	rst	zWriteFMIorII					; Write new value to appropriate part

	; detune/coarse freq, all channels
	sub	80h						; Subtract 80h from 'a' (Detune/coarse frequency of operator 1 register)
	ld	b,4						; Do next 4 bytes (operator 1, 2, 3, and 4)
.detuneloop:
	ld	c,(hl)						; Get next detune/coarse freq
	inc	hl						; next voice byte
	rst	zWriteFMIorII					; Write this detune/coarse freq
	add	a,4						; Next detune/coarse freq register
	djnz	.detuneloop
	
	; other regs up to just before "Total Level", all channels
	add	a,10h						; we're at 40h+, now at 50h+ (RS/AR of operator 1 register)
	ld	b,10h						; Perform 16 writes (basically goes through RS/AR, AM/D1R, D2R, D1L)
.otherloop:
	ld	c,(hl)						; Get next reg data value
	inc	hl						; next voice byte
	rst	zWriteFMIorII					; Write to FM
	add	a,4						; Next register
	djnz	.otherloop

	; Now going to set "stereo output control and LFO sensitivity"
	add	a,24h						; Sets to reg B4h+ (stereo output control and LFO sensitivity)
	ld	c,(ix+zTrack.AMSFMSPan)				; Panning / AMS / FMS settings from track
	rst	zWriteFMIorII					; Write it!

	; Set up a value for future Total Level setting...
	push	ix
	ld	de,zTrack.VoiceTLBuffer
	add	ix,de
	push	ix
	pop	de
	pop	ix

	ld	b,4
.tl:	ld	a,(hl)
	ld	(de),a
	inc	hl
	inc	de
	djnz	.tl
	ret

; Set FM "Total Levels" (general volume control)
; b = volume
; ix = channel
; trashes: a,bc,de,hl
zSetFMTLs:
	push	ix
	pop	hl
	ld	de,zTrack.VoiceTLBuffer
	add	hl,de
	ld	a,(ix+zTrack.VoiceControl)			; Load current voice control byte
	and	3						; Keep only bits 0-2
	add	a,40h						; Add 40h -- appropriate TL register

	ld	d,b						; copy volume to d
	ld	b,4
.l:	push	af
	ld	a,(hl)						; bit 7 being set means it should be effected by channel volume
	or	a
	jp	P,.n
	add	a,d						; Add channel volume
	jr	NC,.n						; If it overflows, cap it to the lowest
	ld	a,7Fh
.n:
	ld	c,a
	pop	af
	rst	zWriteFMIorII
	add	a,4
	inc	hl
	djnz	.l
	ret
; ---------------------------------------------------------------------------

; (via Saxman's doc): F0wwxxyyzz - modulation 
;							o	ww - Wait for ww period of time before modulation starts 
;							o	xx - Modulation Speed 
;							o	yy - Modulation change per Mod. Step 
;							o	zz - Number of steps in modulation 
;zloc_EB0
cfModulation:
	ld	(ix+zTrack.ModulationCtrl),1<<7			; turn modulation on
	dec	hl						; Move 'hl' back one...
	ld	(ix+zTrack.ModulationPtrLow),l			; Back up modulation setting address into (ix+11h), (ix+12h)
	ld	(ix+zTrack.ModulationPtrHigh),h

;zloc_EBB
zSetModulation:
	; Sets up modulation for this track; expects 'hl' to point to modulation
	; configuration info...
	
	; Heh, using some undoc instructions here...
	ld	a,ixl						; Get lower byte of current track address (ew :P)
	add	a,zTrack.ModulationWait				; ... and add 19 bytes to it
	ld	e,a						; put that into 'e'
	adc	a,ixh						; If carry occurred, add that to upper part of address
	sub	e						; subtract 'e'
	ld	d,a						; Basically, 'd' is now the appropriate upper byte of the address, completing de = (ix + 19)
								; Copying next three bytes
	ld	bc,3
	ldir							; while (bc-- > 0) *de++ = *hl++; (wait, modulation speed, modulation change)

	ld	a,(hl)						; Get Number of steps in modulation 
	inc	hl						; Next byte...
	srl	a						; divide number of steps by 2
	ld	(ix+zTrack.ModulationSteps),a			; Store this step count into trackPtr+16h
	bit	playback_noattack,(ix+zTrack.PlaybackControl)	; Is bit 4 "do not attack next note" (10h) set? 
	ret	NZ						; If so, quit!
	xor	a						; Clear 'a'
	ld	(ix+zTrack.ModulationValLow),a			; Clear modulation value low byte
	ld	(ix+zTrack.ModulationValHigh),a			; Clear modulation value high byte
	ret
; ---------------------------------------------------------------------------

; (via Saxman's doc): Turn on modulation 
;zloc_EDE
cfEnableModulation:
	dec	hl
	ld	(ix+zTrack.ModulationCtrl),1<<7			; turn modulation on
	ret
; ---------------------------------------------------------------------------

; (via Saxman's doc): stop the track 
;zloc_EE4
cfStopTrack:
	res	playback_playing,(ix+zTrack.PlaybackControl)	; Clear playback byte bit 7 (80h) -- currently playing (not anymore)
; check if bgm and playing jingle
	ld	a,(zPlaying1upFlag)				; Check if 1-up sound is already playing
	or	a
	jr	Z,.notjingle
	ld	a,(zDoSFXFlag)
	or	a
	jr	NZ,.notjingle
; check if all the bgm tracks are off. yes, all of them.
	ld	hl,zTracksStart
	ld	de,zTrack.len
	rept (zTracksEnd-zTracksStart)/zTrack.len,i
		if i=0
		ld	a,(hl)
		else
		or	(hl)
		endif
		if (i+1)<((zTracksEnd-zTracksStart)/zTrack.len)
		add	hl,de
		endif
	endr
	and	1<<7
	jp	Z,cfFadeInToPrevious
.notjingle:
	res	playback_noattack,(ix+zTrack.PlaybackControl)	; Clear playback byte bit 4 (10h) -- do not attack
	bit	7,(ix+zTrack.VoiceControl)			; Is voice control bit 7 (80h) a PSG track set?
	jr	NZ,.stoppsg					; If so, skip this next part...
	ld	a,(zDACUpdating)				; Is DAC updating?  (FF if so)
	or	a						; test it
	jp	M,zDACStopTrack					; If DAC is updating, go here (we're in a DAC track)
	call	zFMNoteOff					; Otherwise, stop this FM track
	jr	.stopcont
.stoppsg:
	call	zPSGNoteOff
.stopcont:
	; General stop track continues here...

	ld	a,(zDoSFXFlag)					; Check if we're an SFX track
	or	a						; test it
	jr	Z,zStopMusicTrack				; If not, jump to zStopMusicTrack
	xor	a						; a = 0
	ld	(zSFXPriorityVal),a				; Reset SFX priority
	ld	a,(ix+zTrack.VoiceControl)			; Load "voice control" byte
	or	a						; test it..
	jp	M,zStopPSGSFXTrack				; If this is PSG SFX track, jump to zStopPSGSFXTrack
	push	ix						; save 'ix'
	; This is an FM SFX track that's trying to stop
	sub	2						; Take channel assignment - 2 (since SFX never use FM 1 or FM 2)
	add	a,a						; a *= 2 (each table entry is 2 bytes wide)
	call	zGetMusicTrackOffset
	push	hl
	pop	ix
	bit	playback_override,(ix+zTrack.PlaybackControl)	; If "SFX is overriding this track" is not set...
	jp	Z,.sfxoverride					; Skip this part (i.e. if SFX was not overriding this track, then nothing to restore)
	call	zBankSwitchToMusic				; Bank switch back to music track
	res	playback_override,(ix+zTrack.PlaybackControl)	; Clear SFX is overriding this track from playback control
	set	playback_resting,(ix+zTrack.PlaybackControl)	; Set track as resting bit
	call	zSetVoice					; And set it!  (takes care of volume too)

	call	zBankSwitchToSFX
.sfxoverride:
	pop	ix						; restore 'ix'
	pop	bc						; removing return address from stack; will not return to coord flag loop
	pop	bc						; removing return address from stack; will not return to z*UpdateTrack function
	ret
; ---------------------------------------------------------------------------

zStopPSGSFXTrack:
	push	ix						; save 'ix'
	
	; Keep in mind that we just entered with a PSG "voice control" byte
	; which is one of the following values (PSG1-3/3N) -- 80h, A0h, C0h, E0h
	rra
	rra
	rra
	rra							; in effect, ">> 4"
	and	0Fh						; 'a' is now 08, 0A, 0C, or 0E
	call	zGetMusicTrackOffset
	push	hl
	pop	ix
	res	playback_override,(ix+zTrack.PlaybackControl)	; Clear SFX is overriding this track from playback control
	set	playback_resting,(ix+zTrack.PlaybackControl)	; Set track as resting bit
	ld	a,(ix+zTrack.VoiceControl)			; Get voice control byte
	cp	0E0h						; Is this a PSG 3 noise (not tone) track?
	jr	NZ,.psg4					; If it isn't, don't do next part (non-PSG Noise doesn't restore)
	ld	a,(ix+zTrack.PSGNoise)				; Get PSG noise setting
	ld	(zPSG),a					; Write it to PSG
.psg4:
	pop	ix						; restore 'ix'

;zloc_F75
zStopMusicTrack:
	pop	bc						; removing return address from stack; will not return to coord flag loop

;zloc_F76
zDACStopTrack:
	pop	bc						; removing return address from stack; will not return to z*UpdateTrack function (anything othat than DAC) or not to coord flag loop (if DAC)
	ret
; ---------------------------------------------------------------------------

; Fade-in to previous song (needed on DAC channel, Sonic 1 & 2)
;zloc_D35
cfFadeInToPrevious:
	; This performs a "massive" restoration of all of the current 
	; track positions as they were prior to 1-up BGM
	ld	hl,zTracksSaveStart				; Backup memory address
	ld	de,zAbsVar					; Ends at zAbsVar
	ld	bc,zTracksSaveEnd-zTracksSaveStart		; for this many bytes
	ldir							; Go!
	
	call	zBankSwitchToMusic
	ld	a,(zSongDAC.PlaybackControl)			; Get DAC's playback bit
	or	1<<playback_override
	ld	(zSongDAC.PlaybackControl),a			; Set "SFX is overriding" on it (not normal, but will work for this purpose)
	ld	a,(zAbsVar.FadeInCounter)			; Get current count of many frames to continue bringing volume up
	ld	c,a						; 
	ld	a,28h						; 
	sub	c						; a = 28h - c (don't overlap fade-ins?)
	ld	c,a						; 'a' -> 'c'
	ld	b,(zSongPSG1-zSongFM1)/zTrack.len		; 6 FM tracks to follow...
	ld	ix,zSongFM1					; 'ix' points to first FM music track
.fmloop:
	bit	playback_playing,(ix+zTrack.PlaybackControl)	; Is this track playing?
	jr	Z,.fmnop					; If not, do nothing
	set	playback_resting,(ix+zTrack.PlaybackControl)	; Mark track at rest
	ld	a,(ix+zTrack.Volume)				; Get channel volume
	add	a,c						; Apply current fade value
	ld	(ix+zTrack.Volume),a				; Store it back
	bit	playback_override,(ix+zTrack.PlaybackControl)	; Is track being overridden by SFX?
	jr	NZ,.fmnop					; If so, skip next part
	push	bc
	call	zSetVoice					; Update voice (and set volume)
	pop	bc
.fmnop:
	ld	de,zTrack.len
	add	ix,de						; Next track
	djnz	.fmloop						; Keep going for all FM tracks...

	ld	b,(zTracksEnd-zSongPSG1)/zTrack.len		; 3 PSG tracks to follow...
.psgloop:
	bit	playback_playing,(ix+zTrack.PlaybackControl)	; Is this track playing?
	jr	Z,.psgnop					; If not, do nothing
	set	playback_resting,(ix+zTrack.PlaybackControl)	; Set track at rest
	call	zPSGNoteOff					; Shut off PSG
	ld	a,(ix+zTrack.Volume)				; Get channel volume
	add	a,c						; Apply current fade value
	ld	(ix+zTrack.Volume),a				; Store it back
	; Restore PSG noise type
	ld	a,(ix+zTrack.VoiceControl)
	cp	0E0h						; Is this the Noise Channel?
	jr	NZ,.psg4					; If not, branch
	ld	a,(ix+zTrack.PSGNoise)
	ld	(zPSG),a					; Restore Noise setting
.psg4:
.psgnop:
	ld	de,zTrack.len
	add	ix,de						; Next track
	djnz	.psgloop					; Keep going for all FM tracks...

	ld	a,80h
	ld	(zAbsVar.FadeInFlag),a				; Stop any SFX during fade-in
	ld	a,28h
	ld	(zAbsVar.FadeInCounter),a			; Fade in for 28h frames
	xor	a
	ld	(zPlaying1upFlag),a			; Set to zero; 1-up ain't playin' no more
	ld	a,(zAbsVar.DACEnabled)				; DAC not yet enabled...
	ld	c,a
	ld	a,2Bh
	rst	zWriteFMI					; Tell hardware his DAC ain't enabled yet either
	pop	bc
	pop	bc
	pop	bc						; These screw with the return address to make sure DAC doesn't run any further
	jp	zUpdateDAC					; But we update DAC regardless
; ---------------------------------------------------------------------------
; (via Saxman's doc): Change current PSG noise to xx (For noise channel, E0-E7) 
; 0 changes it back to PSG3
;zloc_F78
cfSetPSGNoise:
	or	a
	jr	Z,.psg3
	ld	(ix+zTrack.VoiceControl),0E0h			; This is a PSG noise track now!
	ld	(ix+zTrack.PSGNoise),a				; Save PSG noise setting for restoration if SFX override sit
	bit	playback_override,(ix+zTrack.PlaybackControl)	; If SFX is currently overriding it, don't actually set it!
	ret	NZ
	ld	c,a
	ld	a,0DFh						; mute psg3
	ld	(zPSG),a
	ld	a,c
	ld	(zPSG),a					; set noise mode
	ret
.psg3:
	ld	(ix+zTrack.VoiceControl),0C0h
	bit	playback_override,(ix+zTrack.PlaybackControl)	; If SFX is currently overriding it, don't actually set it!
	ret	NZ
	ld	a,0FFh						; mute noise
	ld	(zPSG),a
	ret
; ---------------------------------------------------------------------------

; (via Saxman's doc): Turn off modulation 
;zloc_F88
cfDisableModulation:
	dec	hl						; No parameters used, must back up a byte
	ld	(ix+zTrack.ModulationCtrl),0			; turn modulation off
	ret
; ---------------------------------------------------------------------------

; (via Saxman's doc): Change current PSG tone to xx 
;zloc_F8E
cfSetPSGTone:
	ld	(ix+zTrack.VolEnvID),a			; Set current PSG tone
	ret
; ---------------------------------------------------------------------------

; (via Saxman's doc): jump to position yyyy 
;zloc_F92
cfJumpTo:
	ld	h,(hl)						; Get hight byte of jump destination (since pointer advanced to it)
	ld	l,a						; Put low byte (already retrieved)
	ret
; ---------------------------------------------------------------------------

; (via Saxman's doc): $F7xxyyzzzz - repeat section of music
;    * xx - loop index, for loops within loops without confusing the engine.
;          o EXAMPLE: Some notes, then a section that is looped twice, then some more notes, and finally the whole thing is looped three times.
;            The "inner" loop (the section that is looped twice) would have an xx of 01, looking something along the lines of F70102zzzz, whereas the "outside" loop (the whole thing loop) would have an xx of 00, looking something like F70003zzzz. 
;    * yy - number of times to repeat
;          o NOTE: This includes the initial encounter of the F7 flag, not number of times to repeat AFTER hitting the flag. 
;    * zzzz - position to loop back to   
;zloc_F95
cfRepeatAtPos:
								; Loop index is in 'a'
	ld	c,(hl)						; Get next byte (number of repeats) -> 'c'
	inc	hl						; Next byte...
	push	hl						; Save 'hl'
	add	a,zTrack.LoopCounters				; Add to make loop index offset (starts at 20h in track memory)
	ld	l,a						; Set hl = offset index
	ld	h,0
	ld	e,ixl						; Set 'de' to beginning of track
	ld	d,ixh
	add	hl,de						; hl is now pointing to track memory offset for this loop
	ld	a,(hl)						; Get loop count at this address
	or	a						; Test it
	jr	NZ,.startloop					; If not zero, then skip next step (i.e. we're currently looping)
	ld	(hl),c						; Otherwise, set it to the new number of repeats
.startloop:
	dec	(hl)						; One less loop
	pop	hl						; Restore 'hl' (now at the position)
	jr	Z,.exitloop					; If counted to zero, skip the rest of this (hence start loop count of 1 terminates the loop without ever looping)
	ld	a,(hl)						; Get low byte of jump address
	inc	hl						; Next byte
	ld	h,(hl)						; Get high byte of jump address -> 'h'
	ld	l,a						; Put low byte of jump address -> 'l'

	; Note then that this loop command only works AFTER the section you mean to loop
	
	ret
.exitloop:
	; If you get here, the loop terminated; just bypass the loop jump address
	inc	hl
	inc	hl
	ret
; ---------------------------------------------------------------------------

; (via Saxman's doc): jump to position yyyy (keep previous position in memory for returning) 
;zloc_FB3
cfJumpToGosub:
	ld	c,a						; a -> c
	ld	a,(ix+zTrack.StackPointer)			; Get current "stack" offset (starts at 2Ah, i.e. beginning of next track)
	sub	2						; Move back by two (we need to store a new return address)
	ld	(ix+zTrack.StackPointer),a			; Set current stack offset
	ld	b,(hl)						; Get high byte of jump position -> 'b'
	inc	hl						; Next byte...
	ex	de,hl						; hl <=> de
	add	a,ixl						; Add low byte of current track pointer to stack offset (low byte of stack location)
	ld	l,a						; Keep this in 'l'
	adc	a,ixh						; Update high byte, if necessary
	sub	l						; Fixhp
	ld	h,a						; a -> 'h' (Simply, we just did hl = ix + stack_offset)
	ld	(hl),e						; Store current address low byte (just after jump) into stack
	inc	hl						; Next byte
	ld	(hl),d						; Store current address high byte (just after jump) into stack
	ld	h,b
	ld	l,c						; hl = bc (current location is where you wanted to jump to)
	ret
; ---------------------------------------------------------------------------

cfWriteFMI:
	ld	c,(hl)
	inc	hl
	rst	zWriteFMI
	ret
; ---------------------------------------------------------------------------

cfSpindashRev:
	dec	hl						; doesn't take an additional arguments
; starts at 0, caps at 9
	ld	a,(zSpindashTimer)
	or	a
	jr	Z,.initialdash
	ld	a,(zSpindashIndex)
	cp	9
	jr	NC,.pitchboundary
	inc	a
.pitchboundary:
.initialdash:
	ld	(zSpindashIndex),a
; update pitch
	add	a,(ix+zTrack.Transpose)				; Add current channels pitch
	ld	(ix+zTrack.Transpose),a				; Store it into channels pitch
; just setting the timer
	ld	a,42
	ld	(zSpindashTimer),a
	ret
; ---------------------------------------------------------------------------
	assert $<=zRamStart
	ifdef OUTPATH
	savebin	OUTPATH, 0, $-0
	endif
